---
import { u } from '../lib/url';
import logo from '../assets/logo/logo.svg';
import { NAV, NAV_MORE, CTA } from '../lib/nav';

const path = Astro.url.pathname;
const isHome = path === u('/');
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class:list={['nav', isHome && 'nav--home']} data-nav>
  <div class="nav__inner">
    <a class="nav__logo" href={u('/')} aria-label="Inicio · Juanito Arcade Mayhem">
      <img src={logo.src} width={logo.width} height={logo.height} alt="" />
    </a>

    <nav class="nav__links" aria-label="Principal">
      {
        NAV.map((i) => (
          <a href={i.href} aria-current={isActive(i.href) ? 'page' : undefined}>
            {i.label}
          </a>
        ))
      }
      <div class="nav__more">
        <button type="button" aria-expanded="false" aria-haspopup="true" data-more>Más</button>
        <div class="nav__dropdown" data-dropdown hidden>
          {
            NAV_MORE.map((i) => (
              <a href={i.href} aria-current={isActive(i.href) ? 'page' : undefined}>
                {i.label}
              </a>
            ))
          }
        </div>
      </div>
    </nav>

    <button class="nav__arcade" type="button" aria-pressed="false" aria-label="Modo arcade" title="Modo arcade" data-arcade>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <circle cx="12" cy="6.2" r="3.4" fill="currentColor" />
        <path d="M12 9.5v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <path d="M5.2 16.5h13.6l-1.3 3.5H6.5z" fill="currentColor" />
      </svg>
    </button>

    <a class="btn btn--primary btn--sm nav__cta" href={CTA.href}>{CTA.label}</a>

    <button class="nav__burger" type="button" aria-label="Abrir menú" aria-expanded="false" data-burger>
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav__sheet" data-sheet hidden>
    <nav aria-label="Menú">
      {
        [...NAV, ...NAV_MORE, CTA].map((i) => (
          <a href={i.href} aria-current={isActive(i.href) ? 'page' : undefined}>
            {i.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  /* barra flotante tipo "pill" de vidrio */
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 14px clamp(0.6rem, 2vw, 1.2rem) 0;
    transition: translate 0.4s ease;
    pointer-events: none;
  }
  .nav.is-hidden {
    translate: 0 -120%;
  }
  .nav__inner {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: min(1240px, 100%);
    margin-inline: auto;
    height: 60px;
    padding: 0 8px 0 18px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    transition: background 0.35s, border-color 0.35s, backdrop-filter 0.35s, box-shadow 0.35s;
  }
  .nav.is-solid .nav__inner,
  .nav.is-open .nav__inner {
    background: rgb(8 16 22 / 0.62);
    border-color: var(--line);
    backdrop-filter: blur(18px) saturate(140%);
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.7);
  }
  /* En la home el logo de la barra aparece recién cuando el logo grande de la
     portada sale de pantalla (así no se ve dos veces). */
  .nav__logo {
    transition: opacity 0.35s ease, translate 0.35s var(--ease-out);
  }
  .nav--home:not(.is-past) .nav__logo {
    opacity: 0;
    translate: 0 -6px;
    pointer-events: none;
  }
  .nav__logo img {
    height: 34px;
    width: auto;
  }
  .nav__links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin-left: auto;
  }
  .nav__links > a,
  .nav__more > button {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--ink-dim);
    text-decoration: none;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-pill);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }
  .nav__links > a:hover,
  .nav__more > button:hover {
    color: var(--ink);
    background: rgb(255 255 255 / 0.06);
  }
  .nav__links > a[aria-current='page'] {
    color: var(--ink);
    background: rgb(255 255 255 / 0.08);
  }
  .nav__more {
    position: relative;
  }
  .nav__more > button::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: 0.5em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    rotate: 45deg;
    translate: 0 -3px;
  }
  .nav__dropdown {
    position: absolute;
    right: 0;
    top: calc(100% + 0.8rem);
    min-width: 240px;
    display: grid;
    padding: 0.4rem;
    border-radius: var(--radius-sm);
    background: rgb(10 20 26 / 0.97);
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.8);
  }
  .nav__dropdown[hidden],
  .nav__sheet[hidden] {
    display: none;
  }
  .nav__dropdown a {
    font-family: var(--font-ui);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    padding: 0.65rem 0.85rem;
    border-radius: 10px;
  }
  .nav__dropdown a:hover,
  .nav__dropdown a[aria-current='page'] {
    background: rgb(255 255 255 / 0.07);
  }
  .nav__cta {
    margin-left: 0.4rem;
  }
  /* botón del modo arcade (joystick) */
  .nav__arcade {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    margin-left: 0.3rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.06);
    color: var(--ink-dim);
    cursor: pointer;
    transition: color 0.2s, background 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .nav__arcade:hover {
    color: var(--ink);
    background: rgb(255 255 255 / 0.1);
  }
  .nav__arcade[aria-pressed='true'] {
    color: #06140c;
    background: var(--lime);
    border-color: var(--lime);
    box-shadow: 0 0 18px rgb(208 236 18 / 0.45);
  }
  .nav__burger {
    display: none;
    margin-left: auto;
    width: 44px;
    height: 44px;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid var(--line);
    border-radius: 50%;
    padding: 13px 12px;
    cursor: pointer;
  }
  .nav__burger span {
    display: block;
    height: 1.5px;
    background: var(--ink);
    margin: 4px 0;
    transition: rotate 0.3s var(--ease-out), translate 0.3s var(--ease-out), opacity 0.2s;
  }
  .nav.is-open .nav__burger span:nth-child(1) {
    translate: 0 5.5px;
    rotate: 45deg;
  }
  .nav.is-open .nav__burger span:nth-child(2) {
    opacity: 0;
  }
  .nav.is-open .nav__burger span:nth-child(3) {
    translate: 0 -5.5px;
    rotate: -45deg;
  }
  .nav__sheet {
    pointer-events: auto;
    position: fixed;
    inset: 84px 0.6rem auto;
    max-height: calc(100dvh - 100px);
    overflow-y: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: rgb(8 16 22 / 0.98);
  }
  .nav__sheet nav {
    display: grid;
    padding: 0.8rem 1.2rem 1.2rem;
  }
  .nav__sheet a {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.35rem;
    color: var(--ink);
    text-decoration: none;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .nav__sheet a:last-child {
    border: 0;
    color: var(--lime);
  }
  .nav__sheet a[aria-current='page'] {
    color: var(--green-neon);
  }

  @media (max-width: 980px) {
    .nav__links,
    .nav__cta {
      display: none;
    }
    .nav__burger {
      display: block;
      margin-left: 0.5rem;
    }
    .nav__arcade {
      margin-left: auto;
      width: 44px;
      height: 44px;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;

  // Modo arcade: filtro CRT en todo el sitio. Se recuerda entre visitas (si el
  // navegador lo permite); Base.astro lo aplica antes de pintar para que no parpadee.
  const arcadeBtn = nav.querySelector<HTMLButtonElement>('[data-arcade]')!;
  const root = document.documentElement;
  arcadeBtn.setAttribute('aria-pressed', String(root.classList.contains('arcade')));
  arcadeBtn.addEventListener('click', () => {
    const on = !root.classList.contains('arcade');
    root.classList.toggle('arcade', on);
    arcadeBtn.setAttribute('aria-pressed', String(on));
    try {
      localStorage.setItem('juanito-arcade', on ? '1' : '0');
    } catch {}
    if (on && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('arcade-on');
      setTimeout(() => root.classList.remove('arcade-on'), 600);
    }
  });

  // Home: mostrar el logo de la barra cuando el logo de la portada ya no se ve.
  const heroLogo = document.querySelector<HTMLElement>('[data-logo]');
  if (nav.classList.contains('nav--home') && heroLogo && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => nav.classList.toggle('is-past', !e.isIntersecting), { rootMargin: '-70px 0px 0px 0px' }).observe(heroLogo);
  } else {
    nav.classList.add('is-past');
  }
  const burger = nav.querySelector<HTMLButtonElement>('[data-burger]')!;
  const sheet = nav.querySelector<HTMLElement>('[data-sheet]')!;
  const more = nav.querySelector<HTMLButtonElement>('[data-more]')!;
  const dropdown = nav.querySelector<HTMLElement>('[data-dropdown]')!;

  // Fondo sólido al bajar; se esconde al bajar y vuelve al subir.
  // Solo cambia después de recorrer un tramo en la misma dirección (UMBRAL): con pasos chicos
  // (scroll lento, inercia o el rebote de iOS) antes se escondía y aparecía seguido y parecía un salto.
  const UMBRAL = 48;
  let last = Math.max(0, window.scrollY);
  let ancla = last; // dónde empezó el tramo actual
  let bajando = false;
  const onScroll = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const y = Math.min(Math.max(0, window.scrollY), max); // ignora el rebote de los bordes
    nav.classList.toggle('is-solid', y > 20);
    const ahora = y > last;
    if (y !== last && ahora !== bajando) {
      bajando = ahora;
      ancla = last;
    }
    if (y < 120) nav.classList.remove('is-hidden');
    else if (!nav.classList.contains('is-open') && Math.abs(y - ancla) > UMBRAL) {
      nav.classList.toggle('is-hidden', bajando);
    }
    last = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  burger.addEventListener('click', () => {
    const open = !nav.classList.contains('is-open');
    nav.classList.toggle('is-open', open);
    nav.classList.add('is-solid');
    sheet.hidden = !open;
    burger.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
  });

  more.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = dropdown.hidden;
    dropdown.hidden = !open;
    more.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', () => {
    dropdown.hidden = true;
    more.setAttribute('aria-expanded', 'false');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      dropdown.hidden = true;
      more.setAttribute('aria-expanded', 'false');
    }
  });
</script>
