---
/**
 * Selector de mundos estilo "pantalla de selección" del juego.
 * Dos modos según el dispositivo:
 *  - Táctil (celular/tablet): scroll horizontal NATIVO con scroll-snap. Es lo más
 *    fluido en un teléfono (inercia y rebote del propio sistema).
 *  - Mouse (PC): la pista se mueve con transform y una animación suavizada que
 *    depende del tiempo (igual a 60 o 144 Hz). Se arrastra con el mouse (con
 *    inercia), rueda o trackpad horizontal, flechas, puntitos o teclado.
 * El oscurecimiento de los costados va por clase: no se recalcula en cada cuadro.
 */
import { Image } from 'astro:assets';
import { maybeAsset } from '../lib/assets';
import type { Mundo } from '../data/types';

interface Props {
  mundos: Mundo[];
}
const { mundos } = Astro.props;
// Numeración solo para los mundos "normales"; el entrenamiento y el jefe final
// muestran su etiqueta (campo `especial`) en lugar de "Mundo N".
const total = mundos.filter((m) => !m.especial).length;
let n = 0;
const etiqueta = mundos.map((m) => (m.especial ? null : ++n));
---

<div class="wc" data-wc>
  <div class="wc__stage">
    <button class="wc__nav wc__nav--prev" type="button" aria-label="Mundo anterior" data-prev>‹</button>
    <div class="wc__viewport" data-viewport tabindex="0" aria-label="Mundos (usá las flechas del teclado para recorrerlos)">
      <ul class="wc__track" data-track>
        {
          mundos.map((m, i) => {
            const chip = maybeAsset(m.chip);
            return (
              <li class:list={['wc__item', i === 0 && 'is-on']} data-i={i}>
                <button type="button" class:list={['wc__card', m.flip && 'is-flip']} aria-label={m.nombre} data-go={i} tabindex="-1">
                  {chip && (
                    <Image src={chip} alt="" widths={[440, 546, 819]} sizes="(max-width: 700px) 100vw, 546px" draggable="false" loading={i < 3 ? 'eager' : 'lazy'} />
                  )}
                </button>
              </li>
            );
          })
        }
      </ul>
    </div>
    <button class="wc__nav wc__nav--next" type="button" aria-label="Mundo siguiente" data-next>›</button>
  </div>

  <!-- texto del mundo activo: todos apilados en la misma celda, solo cambia la opacidad -->
  <div class="wc__info" aria-live="polite">
    {
      mundos.map((m, i) => (
        <article class:list={['wc__panel', i === 0 && 'is-on']} data-panel={i} aria-hidden={i !== 0 ? 'true' : undefined}>
          <p class="wc__num">
            {etiqueta[i] ? (
              <>
                Mundo {String(etiqueta[i]).padStart(2, '0')} <span>/ {String(total).padStart(2, '0')}</span>
              </>
            ) : (
              m.especial
            )}
          </p>
          <h3 class="wc__title">{m.nombre}</h3>
          <p class="wc__desc">{m.descripcion}</p>
        </article>
      ))
    }
  </div>

  <div class="wc__dots" aria-label="Elegir mundo">
    {mundos.map((m, i) => <button type="button" class:list={['wc__dot', i === 0 && 'is-on']} aria-label={m.nombre} data-dot={i} />)}
  </div>
</div>

<style>
  .wc {
    position: relative;
    isolation: isolate;
    padding: clamp(1.5rem, 4vw, 3rem) 0 clamp(1.5rem, 3vw, 2.5rem);
  }
  .wc__stage {
    position: relative;
  }
  .wc__viewport {
    /* tamaño real de los cartuchos (546 px, todos con el mismo lienzo); en pantallas
       chicas se achican todos por igual */
    --card: min(546px, 80vw);
    overflow: hidden;
    padding: 1.5rem 0 2.5rem;
    cursor: grab;
    touch-action: pan-y;
    outline: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .wc__viewport.is-dragging {
    cursor: grabbing;
  }
  .wc__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    will-change: transform;
  }
  .wc__item {
    position: relative;
    flex: 0 0 var(--card);
  }
  /* sombra barata debajo del cartucho (en vez de filter: drop-shadow, caro de repintar) */
  .wc__item::after {
    content: '';
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: 3%;
    height: 8%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.6), transparent);
    z-index: -1;
    pointer-events: none;
  }
  .wc__card {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: inherit;
    -webkit-tap-highlight-color: transparent;
    /* los de los costados quedan oscuros; el activo se ilumina con una transición corta */
    filter: brightness(0.38) saturate(0.7);
    transition: filter 0.35s ease;
  }
  .wc__item.is-on .wc__card {
    filter: none;
  }
  /* el del centro siempre por delante: si un vecino lo roza, queda detrás */
  .wc__item.is-on {
    z-index: 1;
  }
  .wc__card img {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }
  .wc__card.is-flip img {
    transform: scaleX(-1);
  }

  /* Modo táctil: scroll nativo con imán al centro */
  .wc__viewport.is-native {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    touch-action: auto;
    cursor: auto;
  }
  .wc__viewport.is-native::-webkit-scrollbar {
    display: none;
  }
  .wc__viewport.is-native .wc__track {
    width: max-content;
    padding-inline: calc((100vw - var(--card)) / 2);
    will-change: auto;
  }
  .wc__viewport.is-native .wc__item {
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  .wc__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    translate: 0 -50%;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgb(8 14 18 / 0.78);
    color: var(--ink);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .wc__nav:hover {
    background: var(--lime);
    color: #06140c;
  }
  .wc__nav--prev {
    left: clamp(0.5rem, 2vw, 1.5rem);
  }
  .wc__nav--next {
    right: clamp(0.5rem, 2vw, 1.5rem);
  }

  .wc__info {
    display: grid;
    justify-items: center;
    text-align: center;
    padding: 0 clamp(1rem, 4vw, 2rem);
  }
  .wc__panel {
    grid-area: 1 / 1;
    align-self: start;
    max-width: 38rem;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0s 0.3s;
  }
  .wc__panel.is-on {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease;
  }
  .wc__num {
    margin: 0;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-neon);
  }
  .wc__num span {
    color: var(--ink-faint);
  }
  .wc__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .wc__desc {
    margin: 0.3rem 0 0;
    color: var(--ink-dim);
  }

  .wc__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.2rem;
  }
  .wc__dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border-radius: 999px;
    border: 0;
    background: var(--line-strong);
    cursor: pointer;
    transition: width 0.3s var(--ease-out), background 0.3s;
  }
  .wc__dot.is-on {
    width: 26px;
    background: var(--lime);
  }

  @media (max-width: 700px) {
    .wc__viewport {
      --card: 80vw;
    }
    /* en el celular, los cartuchos más grandes: las imágenes traen margen transparente
       (todas comparten el mismo lienzo), así que se agrandan sin taparse con los vecinos */
    .wc__card img {
      scale: 1.12;
    }
    .wc__nav {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wc__card,
    .wc__panel,
    .wc__dot {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-wc]').forEach((root) => {
    const viewport = root.querySelector<HTMLElement>('[data-viewport]')!;
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const items = [...root.querySelectorAll<HTMLElement>('.wc__item')];
    const cards = items.map((el) => el.querySelector<HTMLElement>('.wc__card')!);
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const touch = window.matchMedia('(pointer: coarse)').matches;
    const last = items.length - 1;
    const clamp = (i: number) => Math.max(0, Math.min(last, i));
    let active = 0;

    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      items.forEach((el, k) => el.classList.toggle('is-on', k === i));
      dots.forEach((el, k) => el.classList.toggle('is-on', k === i));
      panels.forEach((el, k) => {
        el.classList.toggle('is-on', k === i);
        el.setAttribute('aria-hidden', String(k !== i));
      });
    };

    let go: (i: number) => void;

    if (touch) {
      // ------------------------------------------------ modo táctil (scroll nativo)
      viewport.classList.add('is-native');
      const centerOf = (el: HTMLElement) => el.offsetLeft + el.offsetWidth / 2 - viewport.clientWidth / 2;
      let lockUntil = 0;
      go = (i) => {
        const k = clamp(i);
        lockUntil = performance.now() + 700;
        viewport.scrollTo({ left: centerOf(items[k]), behavior: reduce ? 'auto' : 'smooth' });
        setActive(k);
      };
      let raf = 0;
      viewport.addEventListener(
        'scroll',
        () => {
          if (raf) return;
          raf = requestAnimationFrame(() => {
            raf = 0;
            if (performance.now() < lockUntil) return;
            const pos = viewport.scrollLeft;
            let best = 0;
            let dist = Infinity;
            items.forEach((el, k) => {
              const d = Math.abs(centerOf(el) - pos);
              if (d < dist) {
                dist = d;
                best = k;
              }
            });
            setActive(best);
          });
        },
        { passive: true },
      );
      cards.forEach((c, k) => c.addEventListener('click', () => go(k)));
    } else {
      // ------------------------------------------------ modo mouse (animado con transform)
      let step = 0;
      let base = 0;
      const measure = () => {
        step = items[0].getBoundingClientRect().width;
        base = viewport.clientWidth / 2 - step / 2;
      };
      const xFor = (i: number) => base - i * step;
      const nearest = (pos: number) => clamp(Math.round((base - pos) / step));

      let x = 0;
      let target = 0;
      let running = false;
      let prev = 0;
      const render = () => {
        track.style.transform = `translate3d(${x.toFixed(2)}px, 0, 0)`;
      };
      const loop = (now: number) => {
        if (!running) return;
        // suavizado exponencial según el tiempo transcurrido (independiente de los FPS)
        const dt = prev ? Math.min(50, now - prev) : 16;
        prev = now;
        x += (target - x) * (1 - Math.exp(-dt / 120));
        if (Math.abs(target - x) < 0.3) {
          x = target;
          running = false;
        }
        render();
        if (running) requestAnimationFrame(loop);
      };
      const animate = () => {
        if (reduce) {
          x = target;
          render();
          return;
        }
        if (!running) {
          running = true;
          prev = 0;
          requestAnimationFrame(loop);
        }
      };
      go = (i) => {
        const k = clamp(i);
        target = xFor(k);
        setActive(k);
        animate();
      };

      // arrastre con el mouse (o lápiz)
      let dragging = false;
      let moved = false;
      let startX = 0;
      let startPos = 0;
      let lastX = 0;
      let lastT = 0;
      let vel = 0;
      viewport.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        dragging = true;
        moved = false;
        startX = lastX = e.clientX;
        lastT = performance.now();
        startPos = x;
        vel = 0;
      });
      viewport.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const dx = e.clientX - startX;
        if (!moved) {
          if (Math.abs(dx) < 5) return;
          moved = true;
          running = false;
          viewport.classList.add('is-dragging');
          viewport.setPointerCapture(e.pointerId);
        }
        const now = performance.now();
        vel = vel * 0.6 + ((e.clientX - lastX) / Math.max(1, now - lastT)) * 0.4; // px/ms suavizada
        lastX = e.clientX;
        lastT = now;
        let next = startPos + dx;
        const min = xFor(last);
        const max = xFor(0);
        if (next > max) next = max + (next - max) * 0.35;
        if (next < min) next = min + (next - min) * 0.35;
        x = target = next;
        render();
        setActive(nearest(x));
      });
      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
        viewport.classList.remove('is-dragging');
        if (!moved) return;
        // si el mouse quedó quieto antes de soltar, no hay inercia
        if (performance.now() - lastT > 90) vel = 0;
        go(nearest(x + vel * 250));
        setTimeout(() => (moved = false), 0);
      };
      viewport.addEventListener('pointerup', endDrag);
      viewport.addEventListener('pointercancel', endDrag);
      viewport.addEventListener('lostpointercapture', endDrag);
      cards.forEach((c, k) =>
        c.addEventListener('click', (e) => {
          if (moved) {
            e.preventDefault();
            return;
          }
          go(k);
        }),
      );

      // rueda / trackpad horizontal
      let wheelAcc = 0;
      let wheelTimer = 0;
      viewport.addEventListener(
        'wheel',
        (e) => {
          if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
          e.preventDefault();
          wheelAcc += e.deltaX;
          clearTimeout(wheelTimer);
          wheelTimer = window.setTimeout(() => (wheelAcc = 0), 180);
          if (Math.abs(wheelAcc) > 60) {
            go(active + Math.sign(wheelAcc));
            wheelAcc = 0;
          }
        },
        { passive: false },
      );

      const init = () => {
        measure();
        x = target = xFor(active);
        render();
      };
      window.addEventListener('resize', init);
      init();
    }

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(active - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(active + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    viewport.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(active + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(active - 1);
      }
    });
  });
</script>
