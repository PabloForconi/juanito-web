---
import { u } from '../lib/url';
import { BUILD } from '../lib/build';
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo-pintado-blanco.png'; // en blanco: en el footer acompaña sin competir con el contenido
import { NAV, NAV_MORE, CTA } from '../lib/nav';
import GameEverCredit from './GameEverCredit.astro';
import { INSTAGRAM } from '../lib/redes';

// Redes como íconos chicos (trazos estilo Lucide). Steam y Game Ever ya están en otros lados del sitio.
const redes = [
  {
    label: 'YouTube',
    href: 'https://www.youtube.com/user/gameeverstudio',
    svg: '<path d="M2.5 17a24.1 24.1 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.6 49.6 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.1 24.1 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.6 49.6 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/>',
  },
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/juanitoarcade/',
    svg: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  },
  {
    label: 'Instagram',
    href: INSTAGRAM,
    svg: '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.4A4 4 0 1 1 12.6 8 4 4 0 0 1 16 11.4z"/><path d="M17.5 6.5h.01"/>',
  },
];
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href={u('/')} aria-label="Inicio"><Image src={logo} alt="Juanito Arcade Mayhem" widths={[320, 640, 960, 1400, 2000]} sizes="200px" /></a>
      <p class="muted">
        El archivo de <b>Juanito Arcade Mayhem</b>, el primer juego de Game Ever Studio. Hecho en Buenos Aires con alfajores, choripanes y
        mucho cariño.
      </p>
      <div class="footer__studio">
        <GameEverCredit size="sm" label="Creado por" byline />
        <ul class="footer__redes">
          {
            redes.map((r) => (
              <li>
                <a href={r.href} target="_blank" rel="noopener" aria-label={r.label} title={r.label}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={r.svg} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <nav aria-label="Secciones" class="footer__col">
      <p class="eyebrow">Archivo</p>
      {NAV.map((i) => <a href={i.href}>{i.label}</a>)}
    </nav>
    <nav aria-label="Más" class="footer__col">
      <p class="eyebrow">Más</p>
      {[...NAV_MORE, CTA].map((i) => <a href={i.href}>{i.label}</a>)}
    </nav>
  </div>
  <div class="container footer__bottom">
    <span>© 2011–2026 Game Ever Studio. Juanito, Gluk y los millones de clonocélulas son propiedad de Game Ever.</span>
    <!-- solo se ve la versión; el commit y la fecha quedan en atributos para chequear -->
    <span class="footer__ver" data-commit={BUILD.commit} data-built={BUILD.date}>Versión {BUILD.version}</span>
    <a class="footer__insert" href={u('/historia/#records')} title="High scores">INSERT COIN ▮</a>
  </div>
</footer>

<style>
  /* sin caja: el fondo de la página se funde a casi negro, sin bordes ni cortes */
  .footer {
    position: relative;
    margin-top: 6rem;
    padding: 4.5rem 0 1.5rem;
  }
  .footer::before {
    content: '';
    position: absolute;
    inset: -12rem 0 0;
    background: linear-gradient(180deg, transparent, rgb(2 4 5 / 0.85) 16rem, #020405 24rem);
    pointer-events: none;
    z-index: -1;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2.5rem;
  }
  .footer__brand img {
    display: block;
    width: 150px;
    height: auto;
    margin-bottom: 1.2rem;
  }
  .footer__brand p {
    max-width: 26rem;
    margin: 0;
  }
  /* «Creado por Game Ever» y, al lado, las redes como íconos */
  .footer__studio {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.2rem 2rem;
    max-width: 26rem;
    margin-top: 1.8rem;
  }
  .footer__redes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.5rem;
  }
  .footer__redes a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--ink-dim);
    transition: color 0.2s, border-color 0.2s;
  }
  .footer__redes svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .footer__redes a:hover,
  .footer__redes a:focus-visible {
    color: var(--green-neon);
    border-color: var(--green-neon);
  }
  .footer__col {
    display: grid;
    align-content: start;
    gap: 0.55rem;
  }
  .footer__col .eyebrow {
    margin-bottom: 0.6rem;
    justify-self: start;
  }
  .footer__col a {
    color: var(--ink-dim);
    text-decoration: none;
    font-family: var(--font-ui);
    font-weight: 500;
    transition: color 0.2s;
  }
  .footer__col a:hover {
    color: var(--ink);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .footer__ver {
    margin-right: auto;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    opacity: 0.8;
  }
  .footer__insert {
    color: var(--lime);
    text-decoration: none;
    letter-spacing: 0.15em;
    /* dos estados, encendido y apagado, sin paso intermedio (0,7 s cada uno) */
    animation: blink 1.4s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  @media (max-width: 800px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
    /* en el celular el logo va centrado y un poco más grande */
    .footer__brand img {
      width: 200px;
      margin-inline: auto;
      margin-bottom: 1.6rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer__insert {
      animation: none;
    }
  }
</style>
