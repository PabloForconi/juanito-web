---
import { u } from '../lib/url';
import { BUILD } from '../lib/build';
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo-pintado.png';
import { NAV, NAV_MORE, CTA } from '../lib/nav';
import GameEverCredit from './GameEverCredit.astro';
import { INSTAGRAM } from '../lib/redes';

const redes = [
  { label: 'Steam', href: 'https://store.steampowered.com/app/617440/' },
  { label: 'YouTube', href: 'https://www.youtube.com/user/gameeverstudio' },
  { label: 'Facebook', href: 'https://www.facebook.com/juanitoarcade/' },
  { label: 'Instagram', href: INSTAGRAM },
  { label: 'Game Ever Studio', href: 'https://www.gameeverstudio.com/' },
];
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href={u('/')} aria-label="Inicio"><Image src={logo} alt="Juanito Arcade Mayhem" widths={[320, 640, 960, 1400, 2000]} sizes="220px" /></a>
      <p class="muted">
        El archivo de <b>Juanito Arcade Mayhem</b>, el primer juego de Game Ever Studio. Hecho en Buenos Aires con alfajores, choripanes y
        mucho cariño.
      </p>
      <div class="footer__studio"><GameEverCredit size="sm" label="Creado por" byline /></div>
    </div>
    <nav aria-label="Secciones" class="footer__col">
      <p class="eyebrow">Archivo</p>
      {NAV.map((i) => <a href={i.href}>{i.label}</a>)}
    </nav>
    <nav aria-label="Más" class="footer__col">
      <p class="eyebrow">Más</p>
      {[...NAV_MORE, CTA].map((i) => <a href={i.href}>{i.label}</a>)}
    </nav>
    <div class="footer__col">
      <p class="eyebrow">Afuera</p>
      {
        redes.map((r) => (
          <a href={r.href} target="_blank" rel="noopener">
            {r.label} ↗
          </a>
        ))
      }
    </div>
  </div>
  <div class="container footer__bottom">
    <span>© 2011–2026 Game Ever Studio. Juanito, Gluk y las clonocélulas son de Game Ever.</span>
    <!-- solo se ve la versión; el commit y la fecha quedan en atributos para chequear -->
    <span class="footer__ver" data-commit={BUILD.commit} data-built={BUILD.date}>Versión {BUILD.version}</span>
    <a class="footer__insert" href={u('/historia/#records')} title="High scores">INSERT COIN ▮</a>
  </div>
</footer>

<style>
  /* sin caja: el fondo de la página se funde a casi negro, sin bordes ni cortes */
  .footer {
    position: relative;
    margin-top: 6rem;
    padding: 4.5rem 0 1.5rem;
  }
  .footer::before {
    content: '';
    position: absolute;
    inset: -12rem 0 0;
    background: linear-gradient(180deg, transparent, rgb(2 4 5 / 0.85) 16rem, #020405 24rem);
    pointer-events: none;
    z-index: -1;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 2.5rem;
  }
  .footer__brand img {
    width: 200px;
    height: auto;
    margin-bottom: 1.2rem;
  }
  .footer__brand p {
    max-width: 26rem;
    margin: 0;
  }
  .footer__studio {
    margin-top: 1.8rem;
  }
  .footer__col {
    display: grid;
    align-content: start;
    gap: 0.55rem;
  }
  .footer__col .eyebrow {
    margin-bottom: 0.6rem;
    justify-self: start;
  }
  .footer__col a {
    color: var(--ink-dim);
    text-decoration: none;
    font-family: var(--font-ui);
    font-weight: 500;
    transition: color 0.2s;
  }
  .footer__col a:hover {
    color: var(--ink);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .footer__ver {
    margin-right: auto;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    opacity: 0.8;
  }
  .footer__insert {
    color: var(--lime);
    text-decoration: none;
    letter-spacing: 0.15em;
    /* dos estados, encendido y apagado, sin paso intermedio (0,7 s cada uno) */
    animation: blink 1.4s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }
  @media (max-width: 800px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer__insert {
      animation: none;
    }
  }
</style>
