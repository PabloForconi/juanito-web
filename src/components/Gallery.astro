---
/**
 * Grilla de imágenes con lightbox. Cada item: ruta en src/assets + epígrafe.
 * La miniatura sale con <Image>; el link apunta a una versión grande (getImage).
 * Las imágenes se ven enteras, con su proporción original (grilla tipo mosaico
 * en columnas), sin recortes.
 */
import { Image, getImage } from 'astro:assets';
import { asset } from '../lib/assets';

interface Item {
  img: string;
  caption: string;
  sub?: string;
  fecha?: string; // en el visor grande, en su propio renglón
  desc?: string; // en el visor grande, debajo del título
  forma?: 'ancha' | 'grande'; // solo en mosaico: ancha = 2 columnas, grande = 2×2
  lugar?: string; // solo en mosaico, en PC: grid-area fija ("fila / columna / fila fin / columna fin")
}
interface Props {
  items: Item[];
  group: string;
  min?: string; // ancho mínimo de columna
  grilla?: boolean; // grilla en filas (orden de lectura) en vez de mosaico en columnas; para piezas de igual forma
  columnas?: number; // con grilla: cantidad fija de columnas (ej. 2 = 50% cada una)
  pie?: boolean; // epígrafe siempre debajo de la imagen (no encima al pasar el mouse)
  celular1?: boolean; // en el celular, una imagen debajo de la otra (para piezas apaisadas)
  mosaico?: boolean; // grilla de cuadrados de 7 columnas (2 en el celular) con piezas anchas y grandes; recorta un poco las apaisadas
  limpia?: boolean; // sin texto sobre ni debajo de la imagen: el título se ve solo en el visor grande
  sinTexto?: boolean; // como limpia, y tampoco hay epígrafe en el visor grande
}
const { items, group, min = '220px', grilla = false, columnas, pie = false, celular1 = false, limpia = false, sinTexto = false, mosaico = false } = Astro.props;
// ancho de cada miniatura para elegir la resolución: con columnas fijas es la fracción del contenedor
// (en el celular las columnas fijas pasan a una sola, a todo el ancho)
const tam = mosaico ? '(max-width: 800px) 50vw, 360px' : columnas ? `(max-width: 600px) 100vw, ${Math.round(1200 / columnas)}px` : `(max-width: 600px) 50vw, ${min}`;

const resolved = await Promise.all(
  items.map(async (it) => {
    const src = asset(it.img);
    const big = await getImage({ src, width: Math.min(src.width, 1800), format: 'webp', quality: 85 });
    return { ...it, src, big: big.src };
  }),
);
---

<ul
  class:list={['gal', mosaico && 'gal--mosaico', grilla && 'gal--grilla', columnas && 'gal--cols', pie && 'gal--pie', celular1 && 'gal--c1']}
  style={`--min:${min}${columnas ? `;--cols:${columnas}` : ''}`}
>
  {
    resolved.map((it) => (
      <li class:list={[it.forma && `gal--${it.forma}`]} style={it.lugar ? `--lugar:${it.lugar}` : undefined} data-reveal>
        <a href={it.big} data-lightbox={group} data-caption={sinTexto ? undefined : it.fecha !== undefined || it.desc !== undefined ? it.caption : it.sub ? `${it.caption} — ${it.sub}` : it.caption}
          data-desc={sinTexto ? undefined : it.desc || undefined}
          data-fecha={sinTexto ? undefined : it.fecha || undefined}>
          <span class="gal__img">
            <Image src={it.src} alt={it.caption} widths={columnas || it.forma ? [480, 720, 1200] : [320, 480, 720]} sizes={tam} loading="lazy" />
          </span>
          {!limpia && !sinTexto && (
            <span class="gal__cap">
              <b>{it.caption}</b>
              {it.sub && <small>{it.sub}</small>}
            </span>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .gal {
    list-style: none;
    margin: 0;
    padding: 0;
    --gap: clamp(0.6rem, 1.5vw, 1rem);
    column-width: var(--min);
    column-gap: var(--gap);
  }
  .gal li {
    break-inside: avoid;
    margin-bottom: var(--gap);
  }
  .gal.gal--grilla {
    columns: auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100% / 2 - var(--gap), var(--min)), 1fr));
    gap: var(--gap);
    align-items: start;
  }
  .gal--grilla li {
    margin: 0;
  }
  .gal.gal--cols {
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
  }
  /* epígrafe debajo: la imagen se ve limpia y el nombre siempre está a la vista */
  .gal--pie .gal__cap {
    position: static;
    padding: 0.55rem 0.7rem 0.65rem;
    background: none;
    translate: 0 0;
    opacity: 1;
  }
  .gal a {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  /* marco propio de la imagen: el zoom al pasar el mouse queda adentro y no invade el epígrafe */
  .gal__img {
    display: block;
    overflow: hidden;
  }
  .gal img {
    width: 100%;
    height: auto;
    display: block;
    transition: scale 0.4s, filter 0.3s;
  }
  .gal a:hover img {
    scale: 1.05;
    filter: brightness(1.1);
  }
  .gal a:hover {
    border-color: var(--line-strong);
  }
  .gal__cap {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    padding: 1.6rem 0.75rem 0.6rem;
    background: linear-gradient(transparent, rgb(3 7 10 / 0.9));
    font-family: var(--font-ui);
    line-height: 1.25;
    translate: 0 30%;
    opacity: 0;
    transition: translate 0.25s, opacity 0.25s;
  }
  .gal a:hover .gal__cap,
  .gal a:focus-visible .gal__cap {
    translate: 0 0;
    opacity: 1;
  }
  .gal__cap b {
    font-weight: 600;
    font-size: 0.92rem;
  }
  .gal__cap small {
    color: var(--ink-dim);
    font-size: 0.8rem;
  }
  /* en pantallas táctiles el epígrafe va debajo de la imagen (no la tapa) */
  /* mosaico: celdas cuadradas, con piezas anchas (2 columnas) y grandes (2×2); la imagen llena la celda.
     El alto sale del ancho de la grilla (unidades cq), así las anchas miden lo mismo que una cuadrada */
  .gal.gal--mosaico {
    --n: 7;
    --celda: calc((100cqw - (var(--n) - 1) * var(--gap)) / var(--n));
    container-type: inline-size;
    columns: auto;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    grid-auto-flow: row dense;
    gap: var(--gap);
  }
  .gal--mosaico li {
    margin: 0;
    height: var(--celda);
  }
  /* en PC cada pieza puede tener un lugar fijo en la grilla */
  @media (min-width: 801px) {
    .gal.gal--mosaico li[style*='--lugar'] {
      grid-area: var(--lugar);
    }
  }
  .gal--mosaico li.gal--ancha {
    grid-column: span 2;
  }
  .gal--mosaico li.gal--grande {
    grid-column: span 2;
    grid-row: span 2;
    height: calc(2 * var(--celda) + var(--gap));
  }
  .gal--mosaico a,
  .gal--mosaico .gal__img {
    height: 100%;
  }
  .gal--mosaico img {
    height: 100%;
    object-fit: cover;
  }
  @media (hover: none) {
    .gal__cap {
      position: static;
      padding: 0.5rem 0.65rem 0.6rem;
      background: none;
      translate: 0 0;
      opacity: 1;
    }
  }
  /* en tablets y celulares, el mosaico pasa a 2 columnas: las apaisadas siguen ocupando el ancho,
     y las cuadradas grandes pasan a una celda, para que entren de a dos */
  @media (max-width: 800px) {
    .gal.gal--mosaico {
      --n: 2;
    }
    .gal--mosaico li.gal--grande {
      grid-column: span 1;
      grid-row: span 1;
      height: var(--celda);
    }
  }
  @media (max-width: 600px) {
    .gal {
      column-width: auto;
      column-count: 2;
    }

    .gal.gal--cols,
    .gal.gal--grilla.gal--c1 {
      grid-template-columns: minmax(0, 1fr);
    }
    .gal.gal--c1:not(.gal--grilla) {
      column-count: 1;
    }
  }
</style>
