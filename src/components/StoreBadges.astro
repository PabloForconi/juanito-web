---
/** Badges de tiendas (Steam, App Store, Google Play), mismo esquema que la web de Game Ever. */
interface Props {
  align?: 'center' | 'start';
  size?: 'md' | 'lg';
}
const { align = 'center', size = 'md' } = Astro.props;

const stores = [
  {
    name: 'Steam',
    href: 'https://store.steampowered.com/app/617440/Arcade_Mayhem_Juanito/',
    path: 'M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z',
  },
  {
    name: 'App Store',
    href: 'https://apps.apple.com/ar/app/arcade-mayhem-shooter/id937951287',
    path: 'M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701',
  },
  {
    name: 'Google Play',
    href: 'https://play.google.com/store/apps/details?id=air.com.gameever.juanitoarcade',
    path: 'M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z',
  },
];
---

<ul class:list={['stores', `stores--${align}`, `stores--${size}`]}>
  {
    stores.map((s) => (
      <li>
        <a class="store" href={s.href} target="_blank" rel="noopener" aria-label={`Disponible en ${s.name}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={s.path} />
          </svg>
          <span class="store__txt">
            <span class="store__cap">Disponible en</span>
            <span class="store__name">{s.name}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .stores {
    list-style: none;
    margin: 0;
    padding: 0;
    /* columnas iguales: todos los badges toman el ancho del más largo */
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    width: max-content;
    max-width: 100%;
    gap: 0.6rem;
  }
  .stores--center {
    margin-inline: auto;
  }
  @media (max-width: 600px) {
    .stores {
      grid-auto-flow: row;
      width: min(100%, 300px);
    }
  }
  .store {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    height: 52px;
    padding: 0 1.15rem 0 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: rgb(8 14 18 / 0.78);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.25s, background 0.25s, transform 0.35s var(--ease-out);
  }
  .store:hover {
    border-color: var(--lime);
    background: rgb(208 236 18 / 0.08);
    transform: translateY(-2px);
  }
  .store svg {
    width: 24px;
    height: 24px;
    fill: currentColor;
    flex: none;
  }
  .store:hover svg {
    fill: var(--lime);
  }
  .store__txt {
    display: grid;
    line-height: 1.05;
    text-align: left;
  }
  .store__cap {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .store__name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    letter-spacing: 0.01em;
  }
  .stores--lg .store {
    height: 60px;
    padding: 0 1.4rem 0 1.1rem;
  }
  .stores--lg .store svg {
    width: 28px;
    height: 28px;
  }
  .stores--lg .store__name {
    font-size: 1.2rem;
  }
</style>
