---
/**
 * Tarjetas de comentarios para leer tranquilo (reseñas de Steam, comentarios de Taringa…).
 * A diferencia de la marquesina, acá cada cita queda quieta y entera.
 */
import type { Cita } from '../data/types';

interface Props {
  items: Cita[];
}
const { items } = Astro.props;
---

<ul class="coms">
  {
    items.map((c) => (
      <li data-reveal>
        <figure class="card com">
          <span class="com__comillas" aria-hidden="true">“</span>
          <blockquote>
            <p>{c.texto}</p>
          </blockquote>
          <figcaption>
            <b>{c.autor}</b>
            {c.url ? (
              <a href={c.url} target="_blank" rel="noopener">
                {c.fuente} ↗
              </a>
            ) : (
              <span>{c.fuente}</span>
            )}
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .coms {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
  }
  .coms > li {
    display: flex;
  }
  .com {
    flex: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.2rem;
    margin: 0;
    padding: 1.6rem 1.4rem 1.3rem;
  }
  .com__comillas {
    position: absolute;
    top: 0.2rem;
    left: 1rem;
    font-family: var(--font-display);
    font-size: 3.6rem;
    line-height: 1;
    color: var(--lime);
    opacity: 0.35;
  }
  .com blockquote {
    margin: 0;
  }
  .com blockquote p {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.35;
  }
  .com figcaption {
    display: grid;
    gap: 0.15rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
  }
  .com figcaption b {
    font-weight: 600;
    color: var(--green-neon);
  }
  .com figcaption a,
  .com figcaption span {
    color: var(--ink-dim);
  }
  .com figcaption a:hover {
    color: var(--ink);
  }
</style>
