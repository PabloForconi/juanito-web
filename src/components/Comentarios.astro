---
/**
 * Comentarios de la gente (reseñas de Steam, comentarios de Taringa…) como papelitos pegados con cinta:
 * papel crema apenas torcido, para diferenciarlos de las tarjetas de vidrio del resto del sitio.
 * A diferencia de la marquesina, cada cita queda quieta y entera.
 * La fuente no se repite (ya la dice el título de la sección): en su lugar van los datos de la reseña, si los hay.
 */
import type { Cita } from '../data/types';
import { fecha } from '../lib/format';

interface Props {
  items: Cita[];
}
const { items } = Astro.props;
const datos = (c: Cita) =>
  [
    c.recomienda && '👍 Recomendado',
    c.horas != null && `${c.horas.toLocaleString('es-AR')} h jugadas`,
    c.fecha && fecha(c.fecha),
    c.utiles && `${c.utiles} la votaron útil`,
  ].filter(Boolean) as string[];
const anonimo = (a: string) => /^Usuario de /.test(a);
---

<ul class="coms">
  {
    items.map((c) => {
      const d = datos(c);
      return (
        <li data-reveal>
          <figure class="com">
            <span class="com__cinta" aria-hidden="true" />
            <blockquote>
              <p>«{c.texto}»</p>
            </blockquote>
            <figcaption>
              <b>— {anonimo(c.autor) ? 'Anónimo' : c.autor}</b>
              {(d.length > 0 || c.url) && (
                <span class="com__datos">
                  {d.join(' · ')}
                  {c.url && (
                    <a href={c.url} target="_blank" rel="noopener" aria-label={`Leer la reseña de ${c.autor}`}>
                      ↗
                    </a>
                  )}
                </span>
              )}
            </figcaption>
          </figure>
        </li>
      );
    })
  }
</ul>

<style>
  .coms {
    list-style: none;
    margin: 0;
    padding: 0.6rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.8rem 1.4rem;
  }
  .coms > li {
    display: flex;
  }
  /* papel crema con una cinta lima arriba; cada uno torcido para un lado */
  .com {
    flex: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 1.7rem 1.4rem 1.2rem;
    background: #f1ecdc;
    color: #2a2418;
    border-radius: 3px;
    box-shadow: 0 14px 30px -12px rgb(0 0 0 / 0.7);
    rotate: -1.2deg;
  }
  .coms > li:nth-child(even) .com {
    rotate: 1deg;
  }
  .coms > li:nth-child(3n) .com {
    rotate: -0.5deg;
  }
  .com__cinta {
    position: absolute;
    top: -11px;
    left: 50%;
    translate: -50% 0;
    width: 90px;
    height: 22px;
    background: rgb(200 255 61 / 0.55);
    rotate: -3deg;
  }
  .com blockquote {
    margin: 0;
  }
  .com blockquote p {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.35;
  }
  .com figcaption {
    display: grid;
    gap: 0.2rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
  }
  .com figcaption b {
    font-weight: 600;
    color: #2a2418;
  }
  .com__datos {
    color: #6b5f45;
    font-size: 0.8rem;
  }
  .com__datos a {
    margin-left: 0.4rem;
    color: #3b6d11;
    text-decoration: none;
    font-weight: 700;
  }
  .com__datos a:hover {
    color: #2a2418;
  }
  @media (prefers-reduced-motion: reduce) {
    .com,
    .coms > li:nth-child(n) .com {
      rotate: none;
    }
  }
</style>
