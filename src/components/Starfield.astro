---
// Fondo fijo: auroras difuminadas (CSS, quietas) + estrellas en canvas.
// Pensado para ser liviano: nada se anima solo; las estrellas se redibujan
// únicamente al scrollear (parallax) o al cambiar el tamaño de la ventana.
---

<div class="bg" aria-hidden="true">
  <div class="bg__aurora bg__aurora--a"></div>
  <div class="bg__aurora bg__aurora--b"></div>
  <div class="bg__aurora bg__aurora--c"></div>
  <canvas class="bg__stars"></canvas>
  <div class="bg__vignette"></div>
</div>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--deep);
  }
  /* Las auroras son gradientes radiales ya suaves: sin filter: blur ni animación. */
  .bg__aurora {
    position: absolute;
    width: 80vmax;
    height: 80vmax;
    border-radius: 50%;
    opacity: 0.55;
  }
  .bg__aurora--a {
    left: -25vmax;
    top: -35vmax;
    background: radial-gradient(circle, rgb(18 181 168 / 0.42), rgb(18 181 168 / 0.12) 40%, transparent 68%);
  }
  .bg__aurora--b {
    right: -30vmax;
    top: 5vh;
    background: radial-gradient(circle, rgb(44 224 108 / 0.28), rgb(44 224 108 / 0.08) 40%, transparent 68%);
  }
  .bg__aurora--c {
    left: 15vw;
    bottom: -50vmax;
    background: radial-gradient(circle, rgb(70 60 200 / 0.28), rgb(70 60 200 / 0.08) 40%, transparent 68%);
  }
  .bg__stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .bg__vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 120% 90% at 50% 40%, transparent 50%, rgb(3 6 9 / 0.85) 100%);
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.bg__stars')!;
  const ctx = canvas.getContext('2d')!;

  type Star = { x: number; y: number; z: number; r: number; a: number };
  let stars: Star[] = [];
  let w = 0;
  let h = 0;
  let queued = false;

  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const nw = canvas.clientWidth;
    const nh = canvas.clientHeight;
    canvas.width = nw * dpr;
    canvas.height = nh * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    if (nw !== w) {
      // regenerar solo si cambia el ancho (evita saltos con la barra del celular)
      stars = Array.from({ length: Math.round((nw * nh) / 5200) }, () => {
        const z = Math.random() * 0.9 + 0.1;
        return { x: Math.random() * nw, y: Math.random() * nh, z, r: Math.random() * 1 + 0.3, a: 0.15 + 0.6 * z * Math.random() };
      });
    }
    w = nw;
    h = nh;
    draw();
  }

  function draw() {
    queued = false;
    const sy = window.scrollY;
    ctx.clearRect(0, 0, w, h);
    for (const s of stars) {
      const y = (((s.y - sy * s.z * 0.15) % h) + h) % h;
      ctx.fillStyle = `rgba(230, 255, 245, ${s.a})`;
      ctx.fillRect(s.x, y, s.r * 1.6, s.r * 1.6);
    }
  }

  // Un solo redibujo por cuadro, y solo cuando hay scroll.
  const request = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(draw);
    }
  };

  resize();
  window.addEventListener('resize', resize);
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    window.addEventListener('scroll', request, { passive: true });
  }
</script>
