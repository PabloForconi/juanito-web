---
/**
 * Embed liviano de YouTube: muestra la miniatura y carga el iframe
 * (youtube-nocookie) recién al hacer clic. Sin youtubeId = "próximamente".
 */
interface Props {
  id?: string;
  title: string;
  hd?: boolean; // miniatura en alta (maxresdefault, 1280×720): solo para videos que la tienen, como el trailer de la home
}
const { id, title, hd = false } = Astro.props;
---

{
  id ? (
    <div class="yt" data-yt={id} data-title={title}>
      <button class="yt__btn" type="button" aria-label={`Reproducir: ${title}`}>
        <img
          src={`https://i.ytimg.com/vi/${id}/${hd ? 'maxresdefault' : 'hqdefault'}.jpg`}
          alt=""
          loading="lazy"
          decoding="async"
          width={hd ? 1280 : 480}
          height={hd ? 720 : 360}
        />
        <span class="yt__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3.5 21 12 6 20.5z" /></svg></span>
      </button>
    </div>
  ) : (
    <div class="yt yt--soon">
      <span>Próximamente</span>
    </div>
  )
}

<style>
  .yt {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: #000;
    overflow: hidden;
  }
  .yt__btn {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .yt {
    container-type: inline-size;
  }
  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter 0.3s;
  }
  /* al pasar el mouse la imagen se oscurece un poco (sin zoom), como en la web de Game Ever */
  @media (hover: hover) {
    .yt:hover img,
    .yt__btn:focus-visible img {
      filter: brightness(0.75);
    }
  }
  /* botón circular con los verdes del logo pintado:
     fondo = degradé de las letras: verde claro arriba (#c5ea1f) a verde de la base (#0bd57b)
     triángulo = azul del contorno (#004470)
     semitransparente en reposo; opaco (y un poco más grande) con el cursor encima */
  .yt__play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    translate: -50% -50%;
    border-radius: 50%;
    background: linear-gradient(180deg, #c5ea1f, #0bd57b);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
    opacity: 0.7;
    transition: opacity 0.25s, scale 0.3s var(--ease-out), box-shadow 0.3s;
  }
  .yt__play svg {
    width: 28px;
    height: 28px;
    margin-left: 4px; /* centrado óptico del triángulo */
    fill: #004470;
  }
  /* el botón crece con el tamaño del video */
  @container (width >= 520px) {
    .yt__play {
      width: 80px;
      height: 80px;
    }
    .yt__play svg {
      width: 34px;
      height: 34px;
      margin-left: 5px;
    }
  }
  @container (width >= 900px) {
    .yt__play {
      width: 104px;
      height: 104px;
    }
    .yt__play svg {
      width: 44px;
      height: 44px;
      margin-left: 6px;
    }
  }
  .yt:hover .yt__play,
  .yt__btn:focus-visible .yt__play {
    opacity: 1;
    scale: 1.08;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.4), 0 0 30px rgb(197 234 31 / 0.4);
  }
  /* :global porque el iframe se crea por JS y no lleva el atributo de scope de Astro */
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .yt--soon {
    display: grid;
    place-items: center;
    cursor: default;
    background:
      radial-gradient(circle at 30% 20%, rgb(44 224 108 / 0.12), transparent 60%),
      linear-gradient(135deg, var(--night-2), var(--deep));
  }
  .yt--soon span {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--ink-dim);
    padding: 0.4em 0.9em;
    border: 1px solid var(--line);
    border-radius: 999px;
  }
</style>

<script>
  // Con un solo clic el video arranca: en lugar de un iframe con autoplay=1 (que
  // algunos navegadores bloquean y obligan a un segundo clic), usamos la API de
  // YouTube y llamamos a playVideo() apenas el reproductor está listo. Si el
  // navegador no deja arrancar con sonido, arranca silenciado (se activa con un clic).
  type YTPlayer = { playVideo(): void; mute(): void; getPlayerState(): number };
  type YTNamespace = { Player: new (el: HTMLElement, opts: unknown) => YTPlayer };
  const w = window as unknown as { YT?: YTNamespace; onYouTubeIframeAPIReady?: () => void };

  let apiReady: Promise<YTNamespace> | null = null;
  const loadApi = () =>
    (apiReady ??= new Promise((resolve) => {
      if (w.YT?.Player) return resolve(w.YT);
      const prev = w.onYouTubeIframeAPIReady;
      w.onYouTubeIframeAPIReady = () => {
        prev?.();
        resolve(w.YT!);
      };
      const tag = document.createElement('script');
      tag.src = 'https://www.youtube.com/iframe_api';
      document.head.append(tag);
    }));

  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
    const btn = box.querySelector('button')!;
    // precarga la API al acercarse al video con el mouse o el teclado, así el clic responde rápido.
    // Con el dedo no: en iPhone, cargar algo al "pasar por encima" obliga a tocar dos veces.
    const conMouse = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse') return;
      btn.removeEventListener('pointerenter', conMouse);
      loadApi();
    };
    btn.addEventListener('pointerenter', conMouse);
    btn.addEventListener('focus', loadApi, { once: true });
    btn.addEventListener(
      'click',
      async () => {
        btn.disabled = true;
        const YT = await loadApi();
        const mount = document.createElement('div');
        box.replaceChildren(mount);
        new YT.Player(mount, {
          host: 'https://www.youtube-nocookie.com',
          videoId: box.dataset.yt,
          playerVars: { autoplay: 1, rel: 0, playsinline: 1 },
          events: {
            onReady: (e: { target: YTPlayer }) => {
              e.target.playVideo();
              // si a los 800 ms ni arrancó ni está cargando (autoplay bloqueado), arranca sin sonido
              setTimeout(() => {
                const st = e.target.getPlayerState(); // -1 sin iniciar, 5 en pausa inicial
                if (st === -1 || st === 5) {
                  e.target.mute();
                  e.target.playVideo();
                }
              }, 800);
            },
          },
        });
        box.querySelector('iframe')?.setAttribute('title', box.dataset.title ?? 'Video');
      },
      { once: true },
    );
  });
</script>
