---
/**
 * Lightbox global: cualquier <a data-lightbox="grupo" href="imagen-grande" data-caption="...">
 * abre la imagen en un <dialog>, con flechas para navegar dentro del grupo.
 * Se monta una sola vez por página.
 */
---

<dialog class="lb" data-lb aria-label="Imagen ampliada">
  <figure>
    <img alt="" data-lb-img />
    <figcaption data-lb-cap></figcaption>
  </figure>
  <button class="lb__btn lb__close" type="button" data-lb-close aria-label="Cerrar">✕</button>
  <button class="lb__btn lb__prev" type="button" data-lb-prev aria-label="Anterior">‹</button>
  <button class="lb__btn lb__next" type="button" data-lb-next aria-label="Siguiente">›</button>
</dialog>

<style>
  .lb {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(3 7 10 / 0.96);
    color: var(--ink);
    overscroll-behavior: contain;
  }
  /* con el visor abierto, la página de atrás no se mueve */
  :global(html.lb-abierto) {
    overflow: hidden;
  }
  .lb::backdrop {
    background: transparent;
  }
  .lb figure {
    margin: 0;
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
    padding: 4rem 4.5rem 1.5rem;
    gap: 1rem;
  }
  .lb img {
    max-width: 100%;
    max-height: calc(100dvh - 9rem);
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 40px 100px -30px rgb(0 0 0 / 0.9);
    transition: opacity 0.2s;
  }
  .lb img.is-cargando {
    opacity: 0;
    transition: none;
  }
  .lb figcaption {
    font-family: var(--font-ui);
    font-weight: 500;
    text-align: center;
    color: var(--ink-dim);
    max-width: 60rem;
  }
  .lb figcaption :global(span) {
    display: block;
  }
  .lb figcaption :global(.lb__t) {
    color: var(--ink);
  }
  .lb figcaption :global(.lb__f),
  .lb figcaption :global(.lb__n) {
    font-size: 0.85em;
    color: var(--ink-faint);
  }
  .lb__btn {
    position: absolute;
    width: 48px;
    height: 48px;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--ink);
    background: rgb(255 255 255 / 0.08);
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    cursor: pointer;
  }
  .lb__close {
    top: 1rem;
    right: 1rem;
  }
  .lb__prev,
  .lb__next {
    top: 50%;
    translate: 0 -50%;
  }
  .lb__prev {
    left: 1rem;
  }
  .lb__next {
    right: 1rem;
  }
  /* en el celular las flechas van abajo, en las esquinas, y el epígrafe queda en el medio,
     entre las dos (nunca debajo de ellas) */
  @media (max-width: 640px) {
    .lb figure {
      padding: 4rem 0.5rem 1rem;
    }
    .lb figcaption {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding-inline: 3.6rem;
      font-size: 0.9rem;
      line-height: 1.3;
    }
    .lb__prev,
    .lb__next {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lb]');
  if (dlg) {
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lb-cap]')!;
    let group: HTMLAnchorElement[] = [];
    let idx = 0;

    const show = (i: number) => {
      idx = (i + group.length) % group.length;
      const a = group[idx];
      // la foto anterior no se muestra mientras carga la nueva: queda invisible hasta el load
      if (img.getAttribute('src') !== a.href) {
        img.classList.add('is-cargando');
        img.removeAttribute('src');
        img.src = a.href;
      }
      img.alt = a.dataset.caption ?? '';
      // epígrafe en renglones: título, descripción, fecha y, con varias fotos, el contador ("2 / 8")
      const renglones: [string, string | false | undefined][] = [
        ['lb__t', a.dataset.caption],
        ['lb__d', a.dataset.desc],
        ['lb__f', a.dataset.fecha],
        ['lb__n', group.length > 1 && `${idx + 1} / ${group.length}`],
      ];
      cap.replaceChildren(
        ...renglones
          .filter(([, t]) => t)
          .map(([c, t]) => Object.assign(document.createElement('span'), { className: c, textContent: t as string })),
      );
      dlg.querySelectorAll<HTMLElement>('.lb__prev, .lb__next').forEach((b) => (b.hidden = group.length < 2));
    };

    const listo = () => img.classList.remove('is-cargando');
    img.addEventListener('load', listo);
    img.addEventListener('error', listo);

    // Grupo = los links visibles con ese nombre (los que un filtro escondió no cuentan)
    // más los ocultos a propósito con data-lb-extra (fotos de un álbum sin miniatura).
    const grupo = (nombre: string) =>
      [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox="${nombre}"]`)].filter(
        (x) => x.offsetParent !== null || x.hasAttribute('data-lb-extra'),
      );

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      // botón que abre un álbum desde la primera foto: <button data-lb-open="grupo">
      const abre = t.closest<HTMLElement>('[data-lb-open]');
      const a = abre ? null : t.closest<HTMLAnchorElement>('a[data-lightbox]');
      if (!abre && !a) return;
      e.preventDefault();
      group = grupo(abre ? abre.dataset.lbOpen! : a!.dataset.lightbox!);
      if (!group.length) return;
      show(a ? group.indexOf(a) : 0);
      dlg.showModal();
      bloquea();
    });
    // Con el visor abierto la página queda fija. En iPhone, overflow: hidden solo no alcanza
    // (a veces el fondo igual scrollea), así que el body pasa a position: fixed en la misma
    // posición y al cerrar se vuelve exactamente al mismo lugar.
    let yGuardado = -1;
    const bloquea = () => {
      if (yGuardado >= 0) return;
      yGuardado = window.scrollY;
      document.documentElement.classList.add('lb-abierto');
      Object.assign(document.body.style, { position: 'fixed', top: `-${yGuardado}px`, left: '0', right: '0' });
    };
    // al cerrar (✕, tocando afuera o Escape) vuelve el scroll de la página
    const libera = () => {
      if (yGuardado < 0) return;
      document.documentElement.classList.remove('lb-abierto');
      Object.assign(document.body.style, { position: '', top: '', left: '', right: '' });
      const html = document.documentElement;
      const prev = html.style.scrollBehavior;
      html.style.scrollBehavior = 'auto';
      window.scrollTo(0, yGuardado);
      html.style.scrollBehavior = prev;
      yGuardado = -1;
    };
    const cerrar = () => {
      dlg.close();
      libera();
    };
    dlg.addEventListener('cancel', libera);
    dlg.addEventListener('close', libera);
    dlg.querySelector('[data-lb-close]')!.addEventListener('click', cerrar);
    dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg || (e.target as HTMLElement).tagName === 'FIGURE') cerrar();
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
  }
</script>
