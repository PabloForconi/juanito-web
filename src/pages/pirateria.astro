---
import { u } from '../lib/url';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Lightbox from '../components/Lightbox.astro';
import { asset } from '../lib/assets';
import { fecha } from '../lib/format';
import capturasData from '../data/pirateria-capturas.json';
import sitiosData from '../data/pirateria-sitios.json';
import type { CapturaPirata, SitioPirata } from '../data/types';

const sitios = sitiosData as SitioPirata[];
const capturas = await Promise.all(
  (capturasData as CapturaPirata[]).map(async (c) => {
    const src = asset(c.img);
    return { ...c, src, big: (await getImage({ src, width: Math.min(src.width, 1400), format: 'webp' })).src };
  }),
);
---

<Base title="Salón de la fama de la piratería" description="Los sitios piratas que subieron Juanito Arcade Mayhem, presentados con cariño y sin links.">
  <PageHeader
    eyebrow="Salón de la fama de la piratería"
    title='Los que <span class="hl">lo regalaron</span>'
    lead="Un juego indie argentino llega a las grandes ligas el día que lo crackean en Rusia.<br />Acá, con todo el cariño, los sitios que lo subieron gratis (sin links, obvio).<br />El que lo compró, lo compró. El que no, ya sabe dónde está la tienda."
  />

  <section class="section">
    <div class="container">
      <ul class="piratas">
        {
          capturas.map((c) => (
            <li data-reveal>
              <a class="card card--hover pirata" href={c.big} data-lightbox="piratas" data-caption={c.chiste}>
                <Image src={c.src} alt="Captura de un sitio pirata" widths={[320, 560]} sizes="(max-width: 600px) 90vw, 300px" />
                <span class="pirata__body">
                  <span class="pirata__chiste">{c.chiste}</span>
                  {c.fecha && <span class="pirata__fecha">{fecha(c.fecha)}</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <h2 class="h2" data-reveal>Otros <span class="hl">mencionados de honor</span></h2>
      <ul class="sitios">
        {
          sitios.map((s) => (
            <li class="card" data-reveal>
              <h3 class="h3">
                {s.nombre}
                {s.pais && <small> · {s.pais}</small>}
              </h3>
              <p class="muted">{s.detalle}</p>
            </li>
          ))
        }
      </ul>
      <div class="buy" data-reveal>
        <p>¿Te dio culpa? Todavía estás a tiempo.</p>
        <a class="btn btn--primary" href={u('/conseguilo/')}>Comprarlo legal</a>
      </div>
    </div>
  </section>
  <Lightbox />
</Base>

<style>
  /* Recortes como las fichas de Conseguilo: la captura completa arriba, de borde a borde, y el texto dentro de la tarjeta */
  .piratas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 1.2rem;
  }
  .piratas li {
    display: grid;
  }
  .pirata {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
  }
  /* Todas las capturas miden 720×1240: se recortan los últimos ~85px, que son la barra de Safari */
  .pirata img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 720 / 1155;
    object-fit: cover;
    object-position: 50% 0;
  }
  .pirata__body {
    display: grid;
    align-content: space-between;
    gap: 0.8rem;
    padding: 1.1rem 1.2rem 1.2rem;
  }
  .pirata__chiste {
    font-size: 0.98rem;
    line-height: 1.45;
  }
  .pirata__fecha {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-dim);
  }
  .sitios {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
  }
  .sitios li {
    padding: 1.1rem;
  }
  .sitios h3 small {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--ink-dim);
  }
  .sitios p {
    margin: 0.4rem 0 0;
  }
  .buy {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.2rem;
  }
</style>
