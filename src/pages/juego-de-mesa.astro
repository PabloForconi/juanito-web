---
import { negrita } from '../lib/negrita';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import YouTube from '../components/YouTube.astro';
import TikTok from '../components/TikTok.astro';
import { asset } from '../lib/assets';
import jdm from '../data/juego-de-mesa.json';

const caja = asset('juego-de-mesa/caja-blockits.jpg');
const logoEditorial = asset('juego-de-mesa/logo-dragon-azul-blanco.png');
// Ficha como el disco de Música: los tres datos de juego arriba y los créditos en filas
const resumen = [jdm.jugadores && `${jdm.jugadores} jugadores`, jdm.duracion, jdm.edad && `${jdm.edad} años`].filter(Boolean);
const ficha: [string, string | undefined][] = [
  ['Diseño', jdm.diseno],
  ['Ilustración', jdm.ilustracion],
  ['Diseño gráfico', jdm.disenoGrafico],
  ['Editorial', jdm.editorial],
  ['Año', String(jdm.anio)],
  ['Mecánica', jdm.mecanica],
];
---

<Base title="Juego de mesa" description={`${jdm.nombre}: el juego de mesa basado en Juanito Arcade Mayhem.`}>
  <PageHeader eyebrow="Juego de mesa" title={`${jdm.nombre.replace('Blockits', '<span class="hl">Blockits</span>')}`} lead={negrita(jdm.descripcion)} />

  <section class="section">
    <div class="container jdm">
      <div class="jdm__art" data-reveal>
        <Image src={caja} alt={`La caja de ${jdm.nombre} sobre una mesa`} widths={[480, 800, 1200]} sizes="(max-width: 800px) 100vw, 480px" />
      </div>
      <div class="ficha" data-reveal>
        <p class="ficha__kicker">Ficha del juego</p>
        <ul class="ficha__resumen">
          {resumen.map((r) => <li>{r}</li>)}
        </ul>
        <dl class="ficha__filas">
          {
            ficha
              .filter(([, v]) => v)
              .map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
          }
        </dl>
        <div class="ficha__pie">
          <a class="btn btn--primary" href={jdm.editorialUrl} target="_blank" rel="noopener">Conseguilo ↗</a>
          <Image class="ficha__logo" src={logoEditorial} alt="El Dragón Azul" widths={[110, 220]} sizes="110px" />
        </div>
      </div>
    </div>

    <div class="container destacados">
      {
        jdm.premios && (
          <div class="card destacado destacado--premio" data-reveal>
            <p class="eyebrow-sm">🏆 Premio</p>
            <p set:html={negrita(jdm.premios)} />
          </div>
        )
      }
      {
        jdm.licencias?.length > 0 && (
          <div class="card destacado" data-reveal>
            <p class="eyebrow-sm">En otros países</p>
            {/* el texto ya nombra a las editoriales: sin chips repetidos */}
            <p set:html={negrita(jdm.internacional ?? jdm.licencias.join(' · '))} />
          </div>
        )
      }
    </div>
  </section>

  {
    jdm.videos?.length > 0 && (
      <section class="section" id="videos">
        <div class="container">
          <div data-reveal>
            <p class="eyebrow">Videos</p>
            <h2 class="h2">
              Miralo <span class="hl">en la mesa</span>
            </h2>
          </div>
          <ul class="vids">
            {jdm.videos.map((v: { titulo: string; youtubeId: string; canal: string; duracion?: string }) => (
              <li data-reveal>
                <YouTube id={v.youtubeId} title={v.titulo} />
                <p class="vids__t">{v.titulo}</p>
                <p class="vids__m">
                  {v.canal}
                  {v.duracion && <> · {v.duracion}</>}
                </p>
              </li>
            ))}
          </ul>
          {jdm.redes?.length > 0 && (
            <div class="redes-bloque">
              <h3 class="h3" data-reveal>En las redes</h3>
              <p class="muted" data-reveal>Gente que lo enseña y lo juega en TikTok.</p>
              <ul class="redes">
                {jdm.redes.map((r) => (
                  <li data-reveal>
                    <TikTok id={r.id} cuenta={r.cuenta}>
                      <p class="vids__t">{r.cuenta}</p>
                      {r.texto && <p class="vids__m">{r.texto}</p>}
                    </TikTok>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }
</Base>

<style>
  /* Como el disco de Música: la caja a un lado y la ficha al otro, sin recuadro, centrada en altura */
  .jdm {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .jdm__art img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.7), 0 0 60px rgb(44 224 108 / 0.12);
  }

  /* Ficha: los datos en filas, como la lista de temas de Música */
  .ficha__kicker {
    margin: 0;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green-neon);
  }
  .ficha__resumen {
    list-style: none;
    margin: 0.6rem 0 1.4rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.4rem;
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
  }
  .ficha__resumen li + li::before {
    content: '·';
    margin-right: 1.4rem;
    margin-left: -0.6rem;
    color: var(--lime);
  }
  .ficha__filas {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .ficha__filas div {
    display: grid;
    grid-template-columns: 9.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 0.2rem;
    border-bottom: 1px solid var(--line);
  }
  .ficha__filas dt {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .ficha__filas dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.02rem;
  }
  /* botón y, al lado, el logo de la editorial en blanco */
  .ficha__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.6rem;
    margin-top: 1.5rem;
  }
  .ficha__logo {
    display: block;
    width: 110px;
    height: auto;
    opacity: 0.85;
  }
  @media (max-width: 520px) {
    .ficha__filas div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
  }

  .destacados {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .destacado {
    padding: 1.4rem 1.5rem;
  }
  .destacado p {
    margin: 0;
  }
  .destacado p + p {
    margin-top: 0.5rem;
  }
  /* el premio resalta con el borde lima más marcado */
  .destacado--premio::after {
    border-color: rgb(208 236 18 / 0.5);
  }
  .eyebrow-sm {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-neon);
  }
  .destacado--premio .eyebrow-sm {
    color: var(--lime);
  }
  @media (max-width: 800px) {
    .jdm,
    .destacados {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .vids {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.2rem;
  }
  .vids__t {
    margin: 0.6rem 0 0;
    font-family: var(--font-heading);
  }
  .vids__m {
    margin: 0.2rem 0 0;
    font-family: var(--font-ui);
    color: var(--ink-dim);
    font-size: 0.9rem;
  }
  .redes-bloque {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .redes-bloque .h3,
  .redes-bloque p {
    margin: 0;
  }
  .redes-bloque p {
    margin-top: 0.35rem;
  }
  .redes {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 300px));
    gap: 1.2rem;
  }
  /* en pantallas angostas la fila se desplaza de costado */
  @media (max-width: 800px) {
    .redes {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(72vw, 280px);
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.5rem;
    }
    .redes li {
      scroll-snap-align: start;
    }
  }
</style>
