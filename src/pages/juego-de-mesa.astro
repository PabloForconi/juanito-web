---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import YouTube from '../components/YouTube.astro';
import TikTok from '../components/TikTok.astro';
import { asset } from '../lib/assets';
import jdm from '../data/juego-de-mesa.json';

const caja = asset('juego-de-mesa/caja-blockits.jpg');
const logoEditorial = asset('juego-de-mesa/logo-dragon-azul.png');
// 9 datos: llenan una grilla de 3×3 sin huecos (en el celular, 2 columnas)
const ficha: [string, string | undefined][] = [
  ['Diseño', jdm.diseno],
  ['Ilustración', jdm.ilustracion],
  ['Diseño gráfico', jdm.disenoGrafico],
  ['Editorial', jdm.editorial],
  ['Año', String(jdm.anio)],
  ['Jugadores', jdm.jugadores],
  ['Duración', jdm.duracion],
  ['Edad', jdm.edad],
  ['Mecánica', jdm.mecanica],
];
---

<Base title="Juego de mesa" description={`${jdm.nombre}: el juego de mesa basado en Juanito Arcade Mayhem.`}>
  <PageHeader eyebrow="Juego de mesa" title={`${jdm.nombre.replace('Blockits', '<span class="hl">Blockits</span>')}`} lead={jdm.descripcion} />

  <section class="section">
    <div class="container jdm">
      <div class="jdm__art" data-reveal>
        <Image src={caja} alt={`La caja de ${jdm.nombre} sobre una mesa`} widths={[480, 800, 1200]} sizes="(max-width: 800px) 100vw, 480px" />
      </div>
      <div data-reveal>
        <dl class="ficha">
          {
            ficha
              .filter(([, v]) => v)
              .map(([k, v]) => (
                <div>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))
          }
        </dl>
        <a class="editorial" href={jdm.editorialUrl} target="_blank" rel="noopener">
          <span class="editorial__logo">
            <Image src={logoEditorial} alt="" widths={[120, 240]} sizes="120px" />
          </span>
          <span class="editorial__txt">
            <small>Editorial oficial y original</small>
            <strong>Ver el juego en El Dragón Azul ↗</strong>
          </span>
        </a>
      </div>
    </div>

    <div class="container destacados">
      {
        jdm.premios && (
          <div class="card destacado destacado--premio" data-reveal>
            <p class="eyebrow-sm">🏆 Premio</p>
            <p>{jdm.premios}</p>
          </div>
        )
      }
      {
        jdm.licencias?.length > 0 && (
          <div class="card destacado" data-reveal>
            <p class="eyebrow-sm">En otros países</p>
            {jdm.internacional && <p>{jdm.internacional}</p>}
            <ul class="lic">
              {jdm.licencias.map((l: string) => (
                <li class="chip">{l}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  {
    jdm.videos?.length > 0 && (
      <section class="section" id="videos">
        <div class="container">
          <div data-reveal>
            <p class="eyebrow">Videos</p>
            <h2 class="h2">
              Miralo <span class="hl">en la mesa</span>
            </h2>
          </div>
          <ul class="vids">
            {jdm.videos.map((v: { titulo: string; youtubeId: string; canal: string; duracion?: string }) => (
              <li data-reveal>
                <YouTube id={v.youtubeId} title={v.titulo} />
                <p class="vids__t">{v.titulo}</p>
                <p class="vids__m">
                  {v.canal}
                  {v.duracion && <> · {v.duracion}</>}
                </p>
              </li>
            ))}
          </ul>
          {jdm.entrevista && (
            <p class="mas" data-reveal>
              <span>Para ver más:</span>{' '}
              <a href={jdm.entrevista.url} target="_blank" rel="noopener">
                {jdm.entrevista.titulo} ↗
              </a>{' '}
              <span class="mas__m">
                · {jdm.entrevista.canal} · {jdm.entrevista.duracion}
              </span>
            </p>
          )}
          {jdm.redes?.length > 0 && (
            <div class="redes-bloque">
              <h3 class="h3" data-reveal>En las redes</h3>
              <p class="muted" data-reveal>Gente que lo enseña y lo juega en TikTok.</p>
              <ul class="redes">
                {jdm.redes.map((r) => (
                  <li data-reveal>
                    <TikTok id={r.id} cuenta={r.cuenta} url={r.url}>
                      <p class="vids__t">{r.cuenta}</p>
                      {r.texto && <p class="vids__m">{r.texto}</p>}
                    </TikTok>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>
    )
  }
</Base>

<style>
  .jdm {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .jdm__art {
    max-width: 480px;
    margin-inline: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.45);
  }
  .jdm__art img {
    display: block;
    width: 100%;
    height: auto;
  }
  .ficha {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
  }
  .ficha div {
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .ficha dt {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-neon);
  }
  .ficha dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-heading);
  }
  /* Link a la editorial: logo sobre fondo claro (es azul y no se lee sobre negro) */
  .editorial {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.9rem;
    padding: 0.7rem 1.1rem 0.7rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.25s;
  }
  .editorial:hover,
  .editorial:focus-visible {
    border-color: var(--green-neon);
  }
  .editorial__logo {
    flex: none;
    display: grid;
    place-items: center;
    width: 108px;
    height: 64px;
    padding: 0.4rem 0.6rem;
    border-radius: calc(var(--radius-sm) - 4px);
    background: #fff;
  }
  .editorial__logo img {
    width: 100%;
    height: auto;
  }
  .editorial__txt {
    display: grid;
    gap: 0.15rem;
  }
  .editorial__txt small {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-neon);
  }
  .editorial__txt strong {
    font-family: var(--font-heading);
    font-weight: 400;
  }

  .destacados {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .destacado {
    padding: 1.4rem 1.5rem;
  }
  .destacado p {
    margin: 0;
  }
  .destacado p + p {
    margin-top: 0.5rem;
  }
  .destacado--premio {
    border-color: rgb(208 236 18 / 0.45);
  }
  .eyebrow-sm {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-neon);
  }
  .destacado--premio .eyebrow-sm {
    color: var(--lime);
  }
  .lic {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .mas {
    margin: 1.2rem 0 0;
    color: var(--ink-dim);
  }
  .mas a {
    color: var(--ink);
  }
  .mas__m {
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }
  @media (max-width: 800px) {
    .jdm,
    .destacados {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* En pantallas medianas y chicas la ficha va en 2 columnas (en 3 se cortan los nombres) */
  @media (max-width: 1100px) and (min-width: 801px), (max-width: 520px) {
    .ficha {
      grid-template-columns: 1fr 1fr;
    }
    /* 9 datos en 2 columnas: el último (Mecánica) ocupa la fila entera */
    .ficha div:last-child {
      grid-column: span 2;
    }
  }
  .vids {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 400px), 1fr));
    gap: 1.2rem;
  }
  .vids__t {
    margin: 0.6rem 0 0;
    font-family: var(--font-heading);
  }
  .vids__m {
    margin: 0.2rem 0 0;
    font-family: var(--font-ui);
    color: var(--ink-dim);
    font-size: 0.9rem;
  }
  .redes-bloque {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .redes-bloque .h3,
  .redes-bloque p {
    margin: 0;
  }
  .redes-bloque p {
    margin-top: 0.35rem;
  }
  .redes {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 300px));
    gap: 1.2rem;
  }
  /* en pantallas angostas la fila se desplaza de costado */
  @media (max-width: 800px) {
    .redes {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(72vw, 280px);
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.5rem;
    }
    .redes li {
      scroll-snap-align: start;
    }
  }
</style>
