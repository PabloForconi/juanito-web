---
import { negrita } from '../lib/negrita';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Lightbox from '../components/Lightbox.astro';
import { asset } from '../lib/assets';
import { fecha, anio, byFecha } from '../lib/format';
import hitosData from '../data/hitos.json';
import eventosData from '../data/eventos.json';
import recordsData from '../data/records.json';
import type { Hito, Evento, Records } from '../data/types';

const hitos = (hitosData as Hito[]).slice().sort(byFecha);
const eventos = (eventosData as Evento[]).filter((e) => !e.oculto).sort(byFecha);

// Hitos agrupados por año
const porAnio = new Map<string, Hito[]>();
// imágenes del hito (propia y/o de un evento, aunque esté oculto): miniatura y versión grande para el visor
const todosEventos = eventosData as Evento[];
const imgsDeHito = (h: Hito): string[] => {
  const lista = h.img ? [h.img].flat() : [];
  if (h.evento) {
    const e = todosEventos.find((x) => x.slug === h.evento!.slug);
    const delEvento = e ? ([e.flyer, ...e.fotos].filter(Boolean) as string[]) : [];
    const elegida = delEvento[h.evento.n ?? 0];
    if (!elegida) throw new Error(`Hito «${h.titulo}»: el evento ${h.evento.slug} no tiene la imagen ${h.evento.n ?? 0}`);
    lista.push(elegida);
  }
  return lista;
};
const hitosImg = new Map(
  await Promise.all(
    hitos
      .filter((h) => h.img || h.evento)
      .map(async (h) => {
        const imgs = await Promise.all(
          imgsDeHito(h).map(async (p) => {
            const src = asset(p);
            const big = (await getImage({ src, width: Math.min(src.width, 1600), format: 'webp', quality: 85 })).src;
            return { src, big };
          }),
        );
        return [h, imgs] as const;
      }),
  ),
);
for (const h of hitos) {
  const y = anio(h.fecha);
  porAnio.set(y, [...(porAnio.get(y) ?? []), h]);
}

// Eventos: portada + fotos grandes para el lightbox
const evs = await Promise.all(
  eventos.map(async (e) => {
    const imgs = [e.flyer, ...e.fotos].filter(Boolean) as string[];
    const big = await Promise.all(
      imgs.map(async (p) => {
        const src = asset(p);
        return (await getImage({ src, width: Math.min(src.width, 1800), format: 'webp', quality: 85 })).src;
      }),
    );
    // la tarjeta usa el recorte "portada" si lo hay; el álbum arranca igual por la imagen entera
    const coverPath = e.portada ?? imgs[0];
    return { ...e, cover: coverPath ? asset(coverPath) : undefined, big, count: imgs.length };
  }),
);
// Récords del gabinete: fotos en grande para el lightbox
const records = recordsData as Records;
const recFotos = await Promise.all(
  records.fotos.map(async (f) => {
    const src = asset(f.img);
    return { ...f, src, big: (await getImage({ src, width: Math.min(src.width, 1600), format: 'webp', quality: 85 })).src };
  }),
);
const pts = (n: number) => n.toLocaleString('es-AR');

const aniosEventos = [...new Set(eventos.map((e) => anio(e.fecha)))];

const cat: Record<Hito['categoria'], string> = {
  origen: 'Origen',
  desarrollo: 'Desarrollo',
  evento: 'Evento',
  lanzamiento: 'Lanzamiento',
  prensa: 'Prensa',
  comunidad: 'Comunidad',
  legado: 'Legado',
};
---

<Base title="Historia" description="De los prototipos en Flash a Steam: la historia de Juanito Arcade Mayhem, de 2011 a hoy.">
  <PageHeader
    eyebrow="Historia"
    title='Un fichín <span class="hl">con alma de dibujo animado</span>'
    lead="Juanito nació en <strong>2011</strong> como un videojuego que también podía convertirse en <strong>dibujo animado</strong>. Por entonces se llamaba «Juanito vs. las Clonocélulas Mutantes del Espacio Exterior». Años de bocetos, expos, gabinetes arcade y alfajores después, <strong>llegó a Steam</strong>. Esta es su línea de tiempo."
  >
    <nav class="years" aria-label="Años">
      {[...porAnio.keys()].map((y) => <a href={`#y${y}`}>{y}</a>)}
    </nav>
  </PageHeader>

  <section class="section">
    <div class="container">
      <ol class="tl">
        {
          [...porAnio.entries()].map(([y, list]) => (
            <li class="tl__year" id={`y${y}`}>
              <h2 class="tl__y">{y}</h2>
              <ol class="tl__items">
                {list.map((h) => {
                  const imgs = hitosImg.get(h) ?? [];
                  return (
                    <li class={`tl__item tl__item--${h.categoria}`} data-reveal>
                      <p class="tl__meta">
                        <span class="chip">{cat[h.categoria]}</span>
                        <time datetime={h.fecha}>{fecha(h.fecha)}</time>
                      </p>
                      <h3 class="h3">{h.titulo}</h3>
                      <p set:html={negrita(h.texto)} />
                      {imgs.length > 0 && (
                        <div class="tl__imgs">
                          {imgs.map((img) => (
                            <a class="tl__img" href={img.big} data-lightbox={`hito-${h.fecha}`} data-caption={`${h.titulo} · ${fecha(h.fecha)}`}>
                              <Image src={img.src} alt={h.titulo} widths={[200, 400]} sizes="(max-width: 700px) 110px, 96px" />
                              <span class="tl__zoom" aria-hidden="true">⤢</span>
                            </a>
                          ))}
                        </div>
                      )}
                      {h.link && (
                        <a
                          class="tl__link"
                          href={h.link}
                          {...(/^https?:\/\//.test(h.link) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                        >
                          Ver más →
                        </a>
                      )}
                    </li>
                  );
                })}
              </ol>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="eventos">
    <div class="container">
      <div data-reveal>
        <p class="eyebrow">Expos y eventos</p>
        <h2 class="h2">El gabinete <span class="hl">salió de gira</span></h2>
        <p class="lead">
          Entre 2014 y 2018 Juanito estuvo en {eventos.length} eventos: ferias, festivales, fiestas y convenciones.
        </p>
      </div>
      {
        aniosEventos.map((y) => (
          <div class="ev-year">
            <h3 class="ev-year__t">{y}</h3>
            <ul class="evs">
              {evs
                .filter((e) => anio(e.fecha) === y)
                .map((e) => (
                  <li data-reveal>
                    <article class="ev card card--hover">
                      {e.cover && (
                        <a href={e.big[0]} data-lightbox={e.slug} data-caption={`${e.nombre} · ${fecha(e.fecha)}`} class="ev__cover">
                          <Image src={e.cover} alt={`${e.nombre}`} widths={[360, 560]} sizes="(max-width: 600px) 90vw, 280px" />
                        </a>
                      )}
                      {e.big.slice(1).map((b, i) => (
                        <a href={b} data-lightbox={e.slug} data-caption={`${e.nombre} · ${fecha(e.fecha)}`} hidden aria-hidden="true" tabindex="-1" data-lb-extra>
                          foto {i + 2}
                        </a>
                      ))}
                      <div class="ev__body">
                        <p class="ev__meta">
                          <time datetime={e.fecha}>{fecha(e.fecha)}</time>
                          {e.count > 1 && (
                            <button type="button" class="ev__count" data-lb-open={e.slug} aria-label={`Ver las ${e.count} fotos de ${e.nombre}`}>
                              {e.count} fotos
                            </button>
                          )}
                        </p>
                        <h4 class="h3">{e.nombre}</h4>
                        {e.lugar && <p class="ev__lugar">{e.lugar}</p>}
                        {e.descripcion && <p class="ev__desc">{e.descripcion}</p>}
                        {e.pedirDatos && <p class="ev__aporte">¿Estuviste en este evento? Mandanos info por nuestras redes.</p>}
                      </div>
                    </article>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section" id="records">
    <div class="container">
      <div data-reveal>
        <p class="eyebrow">Récords</p>
        <h2 class="h2">Los que dejaron <span class="hl">su huella</span></h2>
        <p class="lead">El gabinete guardaba un ranking histórico: ganaba el que más tiempo sobrevivía. MAP fue el rey de la tabla hasta que apareció EMI.</p>
      </div>
      <div class="hs" data-reveal>
        <div class="hs__izq">
        <div class="hs__screen">
          <p class="hs__title">High scores</p>
          <ol class="hs__list">
            {
              records.tabla.map((r, i) => (
                <li class:list={['hs__row', i === 0 && 'is-top']}>
                  <span class="hs__pos">{i + 1}.</span>
                  <span class="hs__ini">{r.ini}</span>
                  <span class="hs__time">{r.tiempo}</span>
                  <span class="hs__pts">{pts(r.puntaje)}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <p class="hs__nota">{records.nota}</p>
        </div>
        <ul class="hs__fotos">
          {
            recFotos.map((f) => (
              <li>
                <a href={f.big} data-lightbox="records" data-caption={`${f.titulo} · ${fecha(f.fecha)}`}>
                  <Image
                    src={f.src}
                    alt={f.titulo}
                    widths={[320, 560, 800]}
                    sizes="(max-width: 900px) 45vw, 260px"
                    style={[f.foco && `--foco:${f.foco}`, f.zoom && `--zoom:${f.zoom}`].filter(Boolean).join(';') || undefined}
                  />
                </a>
                <p>{f.titulo}</p>
                {f.pie && <p class="hs__pie">{f.pie}</p>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
  <Lightbox />
</Base>

<style>
  .years {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.6rem;
  }
  .years a {
    font-family: var(--font-ui);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
  }
  .years a:hover {
    background: rgb(255 255 255 / 0.07);
    color: var(--lime);
  }

  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tl__year {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2rem;
    scroll-margin-top: 100px;
  }
  .tl__y {
    position: sticky;
    top: 100px;
    align-self: start;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 3.2rem);
    color: var(--lime);
    text-shadow: var(--glow-green);
  }
  .tl__items {
    list-style: none;
    margin: 0;
    padding: 0 0 3rem 1.8rem;
    border-left: 1px solid var(--line-strong);
  }
  .tl__item {
    position: relative;
    padding: 0 0 2rem;
  }
  .tl__item::before {
    content: '';
    position: absolute;
    left: calc(-1.8rem - 7px);
    top: 0.45rem;
    width: 12px;
    height: 12px;
    background: var(--green-neon);
    box-shadow: 0 0 12px var(--green-neon);
    rotate: 45deg;
  }
  .tl__item--lanzamiento::before {
    background: var(--lime);
    width: 16px;
    height: 16px;
    left: calc(-1.8rem - 9px);
    box-shadow: 0 0 20px var(--lime);
  }
  .tl__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.4rem;
    font-family: var(--font-ui);
    font-weight: 700;
    color: var(--ink-dim);
  }
  .tl__item p {
    margin: 0.35rem 0 0;
    max-width: 48rem;
  }
  .tl__item--lanzamiento .h3 {
    color: var(--lime);
  }
  /* miniaturas del hito: se abren en grande en el visor */
  .tl__imgs {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 0.8rem;
  }
  .tl__img {
    position: relative;
    display: block;
    width: 96px;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition: border-color 0.2s;
  }
  .tl__img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.4s;
  }
  .tl__img:hover {
    border-color: var(--line-strong);
  }
  .tl__img:hover img {
    scale: 1.04;
  }
  .tl__zoom {
    position: absolute;
    right: 0.3rem;
    bottom: 0.3rem;
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: rgb(3 7 10 / 0.7);
    color: var(--ink);
    font-size: 0.75rem;
  }
  .tl__link {
    display: inline-block;
    margin-top: 0.4rem;
    font-family: var(--font-ui);
    font-weight: 700;
  }

  .ev-year {
    margin-top: 2.5rem;
  }
  .ev-year__t {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.6rem;
    color: var(--green-neon);
  }
  .evs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
  }
  /* Grilla pareja: en cada fila las tarjetas se estiran a la altura de la más alta
     (las de texto corto quedan con espacio libre abajo) */
  .evs > li {
    display: flex;
  }
  .ev {
    flex: 1;
    overflow: hidden;
  }
  .ev__cover {
    position: relative;
    display: block;
  }
  .ev__cover img {
    width: 100%;
    height: auto;
    display: block;
  }
  .ev__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0;
  }
  .ev__count {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.78rem;
    padding: 0.2rem 0.5rem;
    background: var(--surface);
    border: 1px solid var(--green-neon);
    color: var(--lime);
    cursor: pointer;
    transition: background 0.2s;
  }
  .ev__count:hover,
  .ev__count:focus-visible {
    background: rgb(44 224 108 / 0.15);
  }
  /* pedido de datos para eventos con información incompleta */
  .ev__aporte {
    margin: 0.7rem 0 0;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--lime);
  }
  .ev__body {
    padding: 0.9rem 1rem 1.1rem;
  }
  .ev__body time {
    font-family: var(--font-ui);
    font-weight: 700;
    color: var(--green-neon);
    font-size: 0.85rem;
  }
  .ev__body h4 {
    margin: 0.2rem 0 0;
  }
  .ev__lugar,
  .ev__desc {
    margin: 0.3rem 0 0;
    font-size: 0.92rem;
    color: var(--ink-dim);
  }

  /* Récords: pantalla de high scores estilo arcade + fotos de prueba */
  #records {
    scroll-margin-top: 100px;
  }
  .hs {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    margin-top: 2rem;
  }
  /* la pantalla se estira hasta el alto de las fotos, y la nota queda pegada abajo */
  .hs__izq {
    display: flex;
    flex-direction: column;
  }
  .hs__screen {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.4rem, 3.5vw, 2.4rem) clamp(1.1rem, 3.5vw, 2.6rem);
    border-radius: 22px;
    border: 2px solid #1a2a3a;
    background: radial-gradient(120% 90% at 50% 0%, #0d1a2b 0%, #05080f 70%);
    box-shadow: inset 0 0 60px rgb(0 0 0 / 0.8), 0 0 0 6px #0a0f14, 0 0 40px rgb(44 224 108 / 0.12);
  }
  .hs__title {
    margin: 0 0 1.2rem;
    text-align: center;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f8d000;
    text-shadow: 0 0 18px rgb(248 208 0 / 0.45);
  }
  .hs__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .hs__row {
    display: grid;
    grid-template-columns: 2.4em 3.4em minmax(4.5em, 1fr) minmax(7em, 1.4fr);
    gap: 0.6rem;
    align-items: baseline;
    font-family: var(--font-heading);
    font-size: clamp(0.95rem, 2.4vw, 1.2rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: #eef6f2;
  }
  .hs__pos {
    text-align: right;
    color: var(--ink-dim);
  }
  .hs__time {
    text-align: right;
  }
  .hs__pts {
    text-align: right;
  }
  .hs__row.is-top {
    color: var(--lime);
    text-shadow: 0 0 14px rgb(208 236 18 / 0.45);
  }
  .hs__row.is-top .hs__pos {
    color: var(--lime);
  }
  /* fotos de prueba: la vertical (EMI) ocupa dos filas, las otras dos al costado */
  .hs__fotos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  /* la de EMI (vertical) ocupa las dos filas y se estira hasta el alto de las otras dos */
  .hs__fotos li:first-child {
    grid-row: span 2;
    display: flex;
    flex-direction: column;
  }
  .hs__fotos li:first-child a {
    flex: 1;
    min-height: 0;
  }
  .hs__fotos a {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    aspect-ratio: 4 / 3;
  }
  .hs__fotos li:first-child a {
    aspect-ratio: auto;
  }
  .hs__fotos img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--foco, 50% 50%);
    scale: var(--zoom, 1);
    transform-origin: var(--foco, 50% 50%);
    transition: filter 0.3s;
  }
  .hs__fotos a:hover img {
    filter: brightness(1.12);
  }
  .hs__fotos p {
    margin: 0.4rem 0 0;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--ink-dim);
  }
  .hs__fotos .hs__pie {
    margin-top: 0.1rem;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }
  .hs__nota {
    margin: 0.9rem 0 0;
    text-align: center;
    max-width: 52rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  @media (max-width: 900px) {
    .hs {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .tl__year {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .tl__y {
      position: static;
    }
    .tl__img {
      width: 110px;
    }
  }
</style>
