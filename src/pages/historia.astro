---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Lightbox from '../components/Lightbox.astro';
import { asset, maybeAsset } from '../lib/assets';
import { fecha, anio, byFecha } from '../lib/format';
import hitosData from '../data/hitos.json';
import eventosData from '../data/eventos.json';
import type { Hito, Evento } from '../data/types';

const hitos = (hitosData as Hito[]).slice().sort(byFecha);
const eventos = (eventosData as Evento[]).slice().sort(byFecha);

// Hitos agrupados por año
const porAnio = new Map<string, Hito[]>();
for (const h of hitos) {
  const y = anio(h.fecha);
  porAnio.set(y, [...(porAnio.get(y) ?? []), h]);
}

// Eventos: portada + fotos grandes para el lightbox
const evs = await Promise.all(
  eventos.map(async (e) => {
    const imgs = [e.flyer, ...e.fotos].filter(Boolean) as string[];
    const big = await Promise.all(
      imgs.map(async (p) => {
        const src = asset(p);
        return (await getImage({ src, width: Math.min(src.width, 1800), format: 'webp', quality: 85 })).src;
      }),
    );
    return { ...e, cover: imgs[0] ? asset(imgs[0]) : undefined, big, count: imgs.length };
  }),
);
const aniosEventos = [...new Set(eventos.map((e) => anio(e.fecha)))];

const cat: Record<Hito['categoria'], string> = {
  origen: 'Origen',
  desarrollo: 'Desarrollo',
  evento: 'Evento',
  lanzamiento: 'Lanzamiento',
  prensa: 'Prensa',
  comunidad: 'Comunidad',
  legado: 'Legado',
};
---

<Base title="Historia" description="De película animada a videojuego: la historia de Juanito Arcade Mayhem, de 2011 a hoy.">
  <PageHeader
    eyebrow="Historia"
    title='De película animada <span class="hl">a fichín</span>'
    lead="Juanito nació en 2011 como el protagonista de un largometraje animado: «Juanito vs. las Clonocélulas Mutantes del Espacio Exterior». Años de bocetos, expos, gabinetes arcade y alfajores después, terminó siendo un videojuego. Esta es la línea de tiempo."
  >
    <nav class="years" aria-label="Años">
      {[...porAnio.keys()].map((y) => <a href={`#y${y}`}>{y}</a>)}
    </nav>
  </PageHeader>

  <section class="section">
    <div class="container">
      <ol class="tl">
        {
          [...porAnio.entries()].map(([y, list]) => (
            <li class="tl__year" id={`y${y}`}>
              <h2 class="tl__y">{y}</h2>
              <ol class="tl__items">
                {list.map((h) => {
                  const img = maybeAsset(h.img);
                  return (
                    <li class={`tl__item tl__item--${h.categoria}`} data-reveal>
                      <p class="tl__meta">
                        <span class="chip">{cat[h.categoria]}</span>
                        <time datetime={h.fecha}>{fecha(h.fecha)}</time>
                      </p>
                      <h3 class="h3">{h.titulo}</h3>
                      <p>{h.texto}</p>
                      {img && <Image src={img} alt="" widths={[480, 800]} sizes="(max-width: 800px) 90vw, 520px" class="tl__img" />}
                      {h.link && (
                        <a class="tl__link" href={h.link}>
                          Ver más →
                        </a>
                      )}
                    </li>
                  );
                })}
              </ol>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="eventos">
    <div class="container">
      <div data-reveal>
        <p class="eyebrow">Expos y eventos</p>
        <h2 class="h2">El gabinete <span class="hl">salió de gira</span></h2>
        <p class="lead">
          Entre 2014 y 2018 Juanito estuvo en {eventos.length} eventos: ferias, festivales, fiestas y convenciones. Desde 2015, casi
          siempre con su propio gabinete arcade verde. Tocá un evento para ver las fotos.
        </p>
      </div>
      {
        aniosEventos.map((y) => (
          <div class="ev-year">
            <h3 class="ev-year__t">{y}</h3>
            <ul class="evs">
              {evs
                .filter((e) => anio(e.fecha) === y)
                .map((e) => (
                  <li data-reveal>
                    <article class="ev card card--hover">
                      {e.cover && (
                        <a href={e.big[0]} data-lightbox={e.slug} data-caption={`${e.nombre} · ${fecha(e.fecha)}`} class="ev__cover">
                          <Image src={e.cover} alt={`${e.nombre}`} widths={[360, 560]} sizes="(max-width: 600px) 90vw, 280px" />
                          {e.count > 1 && <span class="ev__count">{e.count} fotos</span>}
                        </a>
                      )}
                      {e.big.slice(1).map((b, i) => (
                        <a href={b} data-lightbox={e.slug} data-caption={`${e.nombre} · ${fecha(e.fecha)}`} hidden aria-hidden="true" tabindex="-1">
                          foto {i + 2}
                        </a>
                      ))}
                      <div class="ev__body">
                        <time datetime={e.fecha}>{fecha(e.fecha)}</time>
                        <h4 class="h3">{e.nombre}</h4>
                        {e.lugar && <p class="ev__lugar">{e.lugar}</p>}
                        {e.descripcion && <p class="ev__desc">{e.descripcion}</p>}
                      </div>
                    </article>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
  <Lightbox />
</Base>

<style>
  .years {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.6rem;
  }
  .years a {
    font-family: var(--font-ui);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
  }
  .years a:hover {
    background: rgb(255 255 255 / 0.07);
    color: var(--lime);
  }

  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tl__year {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 2rem;
    scroll-margin-top: 100px;
  }
  .tl__y {
    position: sticky;
    top: 100px;
    align-self: start;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2rem, 4vw, 3.2rem);
    color: var(--lime);
    text-shadow: var(--glow-green);
  }
  .tl__items {
    list-style: none;
    margin: 0;
    padding: 0 0 3rem 1.8rem;
    border-left: 1px solid var(--line-strong);
  }
  .tl__item {
    position: relative;
    padding: 0 0 2rem;
  }
  .tl__item::before {
    content: '';
    position: absolute;
    left: calc(-1.8rem - 7px);
    top: 0.45rem;
    width: 12px;
    height: 12px;
    background: var(--green-neon);
    box-shadow: 0 0 12px var(--green-neon);
    rotate: 45deg;
  }
  .tl__item--lanzamiento::before {
    background: var(--lime);
    width: 16px;
    height: 16px;
    left: calc(-1.8rem - 9px);
    box-shadow: 0 0 20px var(--lime);
  }
  .tl__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.4rem;
    font-family: var(--font-ui);
    font-weight: 700;
    color: var(--ink-dim);
  }
  .tl__item p {
    margin: 0.35rem 0 0;
    max-width: 48rem;
  }
  .tl__item--lanzamiento .h3 {
    color: var(--lime);
  }
  .tl__img {
    margin-top: 0.8rem;
    max-width: 520px;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .tl__link {
    display: inline-block;
    margin-top: 0.4rem;
    font-family: var(--font-ui);
    font-weight: 700;
  }

  .ev-year {
    margin-top: 2.5rem;
  }
  .ev-year__t {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.6rem;
    color: var(--green-neon);
  }
  .evs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
  }
  .ev {
    height: 100%;
    overflow: hidden;
  }
  .ev__cover {
    position: relative;
    display: block;
  }
  .ev__cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .ev__count {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.78rem;
    padding: 0.2rem 0.5rem;
    background: var(--surface);
    border: 1px solid var(--green-neon);
    color: var(--lime);
  }
  .ev__body {
    padding: 0.9rem 1rem 1.1rem;
  }
  .ev__body time {
    font-family: var(--font-ui);
    font-weight: 700;
    color: var(--green-neon);
    font-size: 0.85rem;
  }
  .ev__body h4 {
    margin: 0.2rem 0 0;
  }
  .ev__lugar,
  .ev__desc {
    margin: 0.3rem 0 0;
    font-size: 0.92rem;
    color: var(--ink-dim);
  }

  @media (max-width: 700px) {
    .tl__year {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .tl__y {
      position: static;
    }
  }
</style>
