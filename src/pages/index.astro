---
import { u } from '../lib/url';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import Marquee from '../components/Marquee.astro';
import YouTube from '../components/YouTube.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { asset } from '../lib/assets';
import { medios, logoDe } from '../lib/medios';

/**
 * Home simple y de impacto: hero → citas (adorno) → trailer → logos de prensa → mosaico del archivo → CTA.
 * El detalle vive en cada sección; acá solo se invita a entrar.
 */
// «Hablaron de Juanito»: los 4 medios de más peso que tienen logo (orden de medios.json), en grande
const logosPrensa = medios
  .filter((m) => m.logo)
  .slice(0, 4)
  .map((m) => ({ nombre: m.nombre, logo: logoDe(m.nombre, 1.35)! }));

const tiles = [
  {
    area: 'juego',
    href: u('/el-juego/'),
    eyebrow: 'El juego',
    title: 'Juanito, Gluk y las clonocélulas',
    img: 'archivo/home/juego.jpg',
  },
  {
    area: 'historia',
    href: u('/historia/'),
    eyebrow: 'Historia',
    title: 'Cómo se hizo',
    img: 'archivo/home/historia.jpg',
    pos: '50% 30%', // en el celular (16:9) se ve la pantalla del gabinete
  },
  {
    area: 'prensa',
    href: u('/prensa/'),
    eyebrow: 'Prensa',
    title: 'Lo que dijeron',
    img: 'archivo/home/prensa.jpg',
  },
  {
    area: 'videos',
    href: u('/videos/'),
    eyebrow: 'Videos',
    title: 'Trailers y cinemáticas',
    img: 'archivo/home/videos.jpg',
  },
  {
    area: 'galeria',
    href: u('/galeria/'),
    eyebrow: 'Galería',
    title: 'Arte, afiches y fan art',
    img: 'archivo/fanart/fernando-almada.jpg',
    pos: '50% 25%',
  },
  {
    area: 'expos',
    href: u('/historia/#eventos'),
    eyebrow: 'Eventos',
    title: 'El arcade de gira',
    img: 'archivo/home/eventos.jpg',
  },
  {
    area: 'mesa',
    href: u('/juego-de-mesa/'),
    eyebrow: 'Juego de mesa',
    title: 'Juanito Blockits',
    img: 'archivo/home/mesa.jpg',
  },
  {
    area: 'pirata',
    href: u('/pirateria/'),
    eyebrow: 'Piratería',
    title: 'Los que lo regalaron',
    img: 'archivo/home/pirateria.jpg',
  },
];
---

<Base>
  <main>
    <HomeHero />

    <Marquee />

    <!-- Trailer -->
    <section class="section">
      <div class="container">
        <div class="head" data-reveal>
          <p class="eyebrow">Trailer</p>
          <h2 class="h-display">Así se <span class="hl">juega</span></h2>
        </div>
        <div class="trailer" data-reveal>
          <YouTube id="t8SUKgoI3QU" title="Juanito Arcade Mayhem · Steam Gameplay Trailer" />
        </div>
      </div>
    </section>

    <!-- Hablaron de Juanito: los medios de más peso -->
    <section class="section dijeron" aria-labelledby="dijeron-t">
      <div class="container">
        <div class="head" data-reveal>
          <p class="eyebrow">Prensa</p>
          <h2 class="h-display" id="dijeron-t">Hablaron de <span class="hl">Juanito</span></h2>
        </div>
        <ul class="dijeron__logos" data-reveal>
          {
            logosPrensa.map((m) => (
              <li>
                <Image src={m.logo.img} alt={m.nombre} height={m.logo.h * 2} style={`--h:${m.logo.h}px`} />
              </li>
            ))
          }
        </ul>
        <p class="dijeron__mas" data-reveal>
          <a class="btn btn--sm" href={u('/prensa/')}>Ver toda la prensa →</a>
        </p>
      </div>
    </section>

    <!-- Mosaico del archivo -->
    <section class="section" id="archivo">
      <div class="container">
        <div class="head head--split" data-reveal>
          <div>
            <p class="eyebrow">El archivo</p>
            <h2 class="h-display">Todo lo que <span class="hl">pasó</span></h2>
          </div>
          <p class="lead">
            La ópera prima de Game Ever Studio, hecha en Buenos Aires para el mundo. Acá vas a encontrar todo: cómo se hizo, quién lo hizo, qué
            se dijo y lo que hizo la comunidad.
          </p>
        </div>

        <div class="bento">
          {
            tiles.map((t) => (
              <a class:list={['tile', `tile--${t.area}`]} href={t.href} data-reveal>
                {t.img && (
                  <span class="tile__media">
                    <Image
                      src={asset(t.img)}
                      alt=""
                      class="tile__img"
                      widths={[480, 800, 1200]}
                      sizes="(max-width: 800px) 100vw, 50vw"
                      style={t.pos ? `object-position:${t.pos}` : undefined}
                    />
                  </span>
                )}
                <span class="tile__body">
                  <span class="tile__eyebrow">{t.eyebrow}</span>
                  <span class="tile__title">{t.title}</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta">
      <div class="container" data-reveal>
        <p class="eyebrow">Insert coin</p>
        <h2 class="h-display">¿Lo jugaste?<br /><span class="hl">Todavía estás a tiempo.</span></h2>
        <div class="cta__btns">
          <StoreBadges size="lg" />
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  /* Lo que dijeron: logos grandes y parejos (4 en fila; en columna en el celular) */
  .dijeron__logos {
    list-style: none;
    margin: clamp(1.8rem, 4vw, 2.6rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    gap: 1.6rem 2rem;
  }
  .dijeron__logos li {
    display: grid;
    place-items: center;
  }
  .dijeron__logos img {
    display: block;
    height: var(--h);
    width: auto;
    max-width: 100%;
    opacity: 0.75;
    transition: opacity 0.25s;
  }
  .dijeron__logos li:hover img {
    opacity: 1;
  }
  .dijeron__mas {
    margin: clamp(2.6rem, 5vw, 3.8rem) 0 0;
    text-align: center;
  }
  /* en el celular, uno debajo del otro y más chicos */
  @media (max-width: 600px) {
    .dijeron__logos {
      grid-template-columns: 1fr;
      gap: 2.8rem;
    }
    .dijeron__logos img {
      height: calc(var(--h) * 0.62);
    }
  }
  .head {
    margin-bottom: clamp(1.8rem, 4vw, 3rem);
  }
  .head--split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: end;
  }
  .head--split .lead {
    margin: 0;
  }

  .trailer {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 50px 120px -40px rgb(44 224 108 / 0.35), 0 0 0 1px var(--line);
  }
  .trailer :global(.yt) {
    border: 0;
    border-radius: 0;
  }

  /* ----------------------------------------------------------- bento */
  /* Cada tarjeta: la imagen arriba (recuadro redondeado) y el texto debajo, por fuera de la imagen */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(230px, 24vw, 310px);
    grid-template-areas:
      'juego juego historia prensa'
      'juego juego historia videos'
      'galeria galeria expos mesa'
      'galeria galeria pirata pirata';
    gap: clamp(1rem, 2vw, 1.6rem) clamp(0.7rem, 1.4vw, 1rem);
  }
  .tile {
    position: relative;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.75rem;
    color: var(--ink);
    text-decoration: none;
  }
  .tile--juego { grid-area: juego; }
  .tile--historia { grid-area: historia; }
  .tile--prensa { grid-area: prensa; }
  .tile--videos { grid-area: videos; }
  .tile--galeria { grid-area: galeria; }
  .tile--expos { grid-area: expos; }
  .tile--mesa { grid-area: mesa; }
  .tile--pirata { grid-area: pirata; }

  .tile__media {
    position: relative;
    display: block;
    overflow: hidden;
    min-height: 0;
    border-radius: var(--radius);
    background: linear-gradient(160deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.015));
    isolation: isolate;
    transition: box-shadow 0.3s;
  }
  /* El borde va en una capa encima de la imagen: así tapa el filo donde se recorta la imagen
     y la esquina redondeada se ve limpia (si el borde va en el recuadro, las dos curvas no coinciden).
     Lima tenue en reposo; al pasar el mouse se enciende con un brillo suave.
     Va en 2px (Chrome redondea 1.5px a 1px) con un halo muy leve: una línea de 1px en la curva se ve serruchada. */
  .tile__media::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid rgb(208 236 18 / 0.26);
    border-radius: inherit;
    box-shadow: inset 0 0 6px rgb(208 236 18 / 0.18);
    pointer-events: none;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .tile__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    transition: scale 0.8s var(--ease-out), filter 0.4s;
  }
  .tile:focus-visible .tile__media {
    box-shadow: 0 0 22px -4px rgb(208 236 18 / 0.45);
  }
  .tile:focus-visible .tile__media::after {
    border-color: var(--lime);
    box-shadow: inset 0 0 8px rgb(208 236 18 / 0.35);
  }
  /* hover solo con mouse: en el celular el toque dejaba la tarjeta encendida */
  @media (hover: hover) {
    .tile:hover .tile__media {
      box-shadow: 0 0 22px -4px rgb(208 236 18 / 0.45);
    }
    .tile:hover .tile__media::after {
      border-color: var(--lime);
      box-shadow: inset 0 0 8px rgb(208 236 18 / 0.35);
    }
    .tile:hover .tile__img {
      scale: 1.06;
    }
  }
  .tile__body {
    display: grid;
    gap: 0.2rem;
    max-width: 34rem;
  }
  .tile__eyebrow {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-neon);
  }
  .tile__title {
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 1.5vw, 1.4rem);
    line-height: 1.15;
  }
  .cta {
    text-align: center;
  }
  .cta .eyebrow {
    margin-inline: auto;
  }
  .cta__btns {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.2rem;
  }

  @media (max-width: 980px) {
    .head--split {
      grid-template-columns: 1fr;
    }
    .bento {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 250px;
      grid-template-areas:
        'juego juego'
        'historia prensa'
        'historia videos'
        'galeria galeria'
        'expos mesa'
        'pirata pirata';
    }
  }
  @media (max-width: 520px) {
    .bento {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      grid-template-areas: 'juego' 'historia' 'prensa' 'videos' 'galeria' 'expos' 'mesa' 'pirata';
    }
    .tile__media {
      aspect-ratio: 16 / 9;
    }
  }
</style>
