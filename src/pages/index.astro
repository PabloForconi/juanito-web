---
import { u } from '../lib/url';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import Marquee from '../components/Marquee.astro';
import YouTube from '../components/YouTube.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { asset } from '../lib/assets';
import prensa from '../data/prensa.json';
import radio from '../data/radio.json';
import videos from '../data/videos.json';
import eventosData from '../data/eventos.json';
import fanart from '../data/fanart.json';
import { medios, logoDe } from '../lib/medios';
import type { Evento } from '../data/types';

/**
 * Home simple y de impacto: hero → citas → trailer → mosaico del archivo → CTA.
 * El detalle vive en cada sección; acá solo se invita a entrar.
 */
// Franja de logos de prensa: los medios de más peso que tienen logo
const logosPrensa = medios
  .filter((m) => m.logo)
  .slice(0, 7)
  .map((m) => ({ nombre: m.nombre, logo: logoDe(m.nombre, 0.9)! }));

const eventos = (eventosData as Evento[]).filter((e) => !e.oculto);

const tiles = [
  {
    area: 'juego',
    href: u('/el-juego/'),
    eyebrow: 'El juego',
    title: 'Ocho videojuegos infectados',
    text: 'Juanito, Gluk, los mundos, los jefes y el bestiario de clonocélulas.',
    img: 'hero/full.png',
  },
  {
    area: 'historia',
    href: u('/historia/'),
    eyebrow: 'Historia',
    title: 'Un fichín con alma de dibujo animado',
    text: 'De 2011 a hoy, año por año.',
    img: 'archivo/galeria/afiche/retro-dubi-juanito-gluk.jpg',
    pos: '30% 50%',
  },
  {
    area: 'prensa',
    href: u('/prensa/'),
    eyebrow: 'Prensa',
    big: String(prensa.filter((n) => !('caida' in n && n.caida)).length),
    title: 'notas y reseñas',
    text: `Más ${radio.length} audios de radio.`,
  },
  {
    area: 'videos',
    href: u('/videos/'),
    eyebrow: 'Videos',
    title: `${videos.length} videos`,
    text: 'Trailers, animación y gameplays.',
    img: 'archivo/galeria/fondos/wallpaper-volver-al-futuro.jpg',
  },
  {
    area: 'galeria',
    href: u('/galeria/'),
    eyebrow: 'Galería',
    title: 'Arte, afiches y fan art',
    text: `${fanart.length} dibujos de la comunidad.`,
    img: 'archivo/fanart/fernando-almada.jpg',
    pos: '50% 25%',
  },
  {
    area: 'expos',
    href: u('/historia/#eventos'),
    eyebrow: 'Expos',
    title: `${eventos.length} eventos`,
    text: 'El gabinete salió de gira.',
    // primera foto de Geek Out! Fest 2.0 (los nombres llevan una huella del contenido: se buscan en los datos)
    img: eventos.find((e) => e.slug === 'geek-out-fest-2')!.fotos[0],
  },
  {
    area: 'mesa',
    href: u('/juego-de-mesa/'),
    eyebrow: 'Juego de mesa',
    title: 'Juanito Blockits',
    text: 'Hasta Chile y Alemania.',
    img: 'juego/mundos/chip-tetris.png',
    contain: true,
  },
  {
    area: 'pirata',
    href: u('/pirateria/'),
    eyebrow: 'Salón de la fama',
    title: 'Los que lo piratearon',
    text: 'Con cariño y sin links.',
    img: 'archivo/pirateria/skidrowgamereloaded.jpg',
    pos: '50% 40%',
    pirate: true,
  },
];
---

<Base>
  <main>
    <HomeHero />

    <Marquee />

    <!-- Medios que hablaron del juego -->
    <section class="press" aria-labelledby="press-t">
      <div class="container">
        <a class="press__link" href={u('/prensa/')}>
          <p class="press__t" id="press-t">Hablaron de Juanito</p>
          <ul class="press__list">
            {
              logosPrensa.map((m) => (
                <li>
                  <Image src={m.logo.img} alt={m.nombre} height={m.logo.h * 2} style={`height:${m.logo.h}px`} />
                </li>
              ))
            }
          </ul>
        </a>
      </div>
    </section>

    <!-- Trailer -->
    <section class="section">
      <div class="container">
        <div class="head" data-reveal>
          <p class="eyebrow">Trailer</p>
          <h2 class="h-display">Así se <span class="hl">juega</span></h2>
        </div>
        <div class="trailer" data-reveal>
          <YouTube id="t8SUKgoI3QU" title="Juanito Arcade Mayhem · Steam Gameplay Trailer" />
        </div>
      </div>
    </section>

    <!-- Mosaico del archivo -->
    <section class="section" id="archivo">
      <div class="container">
        <div class="head head--split" data-reveal>
          <div>
            <p class="eyebrow">El archivo</p>
            <h2 class="h-display">Todo lo que <span class="hl">pasó</span></h2>
          </div>
          <p class="lead">
            El primer juego de Game Ever Studio, hecho en Buenos Aires. Acá está todo: cómo se hizo, quién lo hizo, qué se dijo y lo que hizo la
            comunidad.
          </p>
        </div>

        <div class="bento">
          {
            tiles.map((t) => (
              <a class:list={['tile', `tile--${t.area}`, !t.img && 'tile--text', t.contain && 'tile--contain']} href={t.href} data-reveal>
                {t.img && (
                  <Image
                    src={asset(t.img)}
                    alt=""
                    class="tile__img"
                    widths={[480, 800, 1200]}
                    sizes="(max-width: 800px) 100vw, 50vw"
                    style={t.pos ? `object-position:${t.pos}` : undefined}
                  />
                )}
                {t.pirate && <span class="tile__flag" aria-hidden="true">☠</span>}
                <span class="tile__body">
                  <span class="tile__eyebrow">{t.eyebrow}</span>
                  {t.big && <span class="tile__big">{t.big}</span>}
                  <span class="tile__title">{t.title}</span>
                  <span class="tile__text">{t.text}</span>
                </span>
                <span class="tile__go" aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta">
      <div class="container" data-reveal>
        <p class="eyebrow">Insert coin</p>
        <h2 class="h-display">¿Lo jugaste?<br /><span class="hl">Todavía estás a tiempo.</span></h2>
        <div class="cta__btns">
          <StoreBadges size="lg" />
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  /* Franja de logos de prensa */
  .press {
    padding: clamp(1.8rem, 4vw, 2.8rem) 0 0;
  }
  .press__link {
    display: grid;
    justify-items: center;
    gap: 1.2rem;
    color: inherit;
    text-decoration: none;
  }
  .press__t {
    margin: 0;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
    transition: color 0.2s;
  }
  .press__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.2rem clamp(1.6rem, 3.5vw, 3rem);
  }
  .press__list img {
    display: block;
    width: auto;
    max-width: 100%;
    opacity: 0.55;
    transition: opacity 0.25s;
  }
  @media (max-width: 600px) {
    .press__list li:nth-child(n + 7) {
      display: none;
    }
  }
  .press__link:hover .press__t {
    color: var(--lime);
  }
  .press__link:hover img {
    opacity: 0.9;
  }
  .head {
    margin-bottom: clamp(1.8rem, 4vw, 3rem);
  }
  .head--split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: end;
  }
  .head--split .lead {
    margin: 0;
  }

  .trailer {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 50px 120px -40px rgb(44 224 108 / 0.35), 0 0 0 1px var(--line);
  }
  .trailer :global(.yt) {
    border: 0;
    border-radius: 0;
  }

  /* ----------------------------------------------------------- bento */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(180px, 20vw, 250px);
    grid-template-areas:
      'juego juego historia prensa'
      'juego juego historia videos'
      'galeria galeria expos mesa'
      'galeria galeria pirata pirata';
    gap: clamp(0.7rem, 1.4vw, 1rem);
  }
  .tile {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(160deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.015));
    color: var(--ink);
    text-decoration: none;
    isolation: isolate;
    transition: border-color 0.3s, transform 0.5s var(--ease-out);
  }
  .tile--juego { grid-area: juego; }
  .tile--historia { grid-area: historia; }
  .tile--prensa { grid-area: prensa; }
  .tile--videos { grid-area: videos; }
  .tile--galeria { grid-area: galeria; }
  .tile--expos { grid-area: expos; }
  .tile--mesa { grid-area: mesa; }
  .tile--pirata { grid-area: pirata; }

  .tile__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: scale 0.8s var(--ease-out), filter 0.4s;
  }
  .tile::before {
    /* degradé para que el texto se lea sobre la imagen */
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(4 8 11 / 0.92) 0%, rgb(4 8 11 / 0.35) 45%, transparent 75%);
  }
  .tile--text::before {
    background: radial-gradient(circle at 80% 10%, rgb(44 224 108 / 0.18), transparent 60%);
  }
  .tile--contain .tile__img {
    object-fit: contain;
    padding: 12% 20% 34%;
    filter: drop-shadow(0 20px 30px rgb(0 0 0 / 0.6));
  }
  .tile--pirata .tile__img {
    filter: grayscale(1) contrast(1.1) brightness(0.55);
  }
  .tile:hover {
    border-color: rgb(255 255 255 / 0.22);
  }
  .tile:hover .tile__img {
    scale: 1.06;
  }
  .tile--pirata:hover .tile__img {
    filter: grayscale(0.4) brightness(0.7);
  }

  .tile__body {
    display: grid;
    gap: 0.25rem;
    max-width: 30rem;
  }
  .tile__eyebrow {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-neon);
  }
  .tile__big {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 0.9;
    background: var(--grad-brand);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tile__title {
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 1.7vw, 1.55rem);
    line-height: 1.15;
  }
  .tile--juego .tile__title {
    font-family: var(--font-display);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    line-height: 1;
  }
  .tile__text {
    font-size: 0.95rem;
    color: var(--ink-dim);
  }
  .tile__go {
    position: absolute;
    top: clamp(0.9rem, 1.6vw, 1.2rem);
    right: clamp(0.9rem, 1.6vw, 1.2rem);
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgb(4 8 11 / 0.7);
    transition: background 0.3s, color 0.3s, rotate 0.4s var(--ease-out);
  }
  .tile:hover .tile__go {
    background: var(--lime);
    color: #06140c;
    rotate: -45deg;
  }
  .tile__flag {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -60%;
    font-size: clamp(3rem, 6vw, 5rem);
    opacity: 0.85;
    z-index: -1;
  }

  .cta {
    text-align: center;
  }
  .cta .eyebrow {
    margin-inline: auto;
  }
  .cta__btns {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.2rem;
  }

  @media (max-width: 900px) {
    .head--split {
      grid-template-columns: 1fr;
    }
    .bento {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 200px;
      grid-template-areas:
        'juego juego'
        'historia prensa'
        'historia videos'
        'galeria galeria'
        'expos mesa'
        'pirata pirata';
    }
  }
  @media (max-width: 520px) {
    .bento {
      grid-template-columns: 1fr;
      grid-auto-rows: 210px;
      grid-template-areas: 'juego' 'historia' 'prensa' 'videos' 'galeria' 'expos' 'mesa' 'pirata';
    }
  }
</style>
