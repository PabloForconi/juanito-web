---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Gallery from '../components/Gallery.astro';
import Lightbox from '../components/Lightbox.astro';
import { maybeAsset } from '../lib/assets';
import { fecha } from '../lib/format';
import galeriaData from '../data/galeria.json';
import fanartData from '../data/fanart.json';
import hitosData from '../data/hitos.json';
import type { ItemGaleria, FanArt, Hito } from '../data/types';

// las imágenes que ya están en la línea de tiempo (Historia) no se repiten acá
const enHistoria = new Set((hitosData as Hito[]).flatMap((h) => (h.img ? [h.img].flat() : [])));
const galeria = (galeriaData as ItemGaleria[]).filter((g) => !g.oculto && !enHistoria.has(g.img));
// Series que se muestran juntas dentro de su categoría (título y texto del bloque)
const series: Record<string, { titulo: string; txt: string }> = {
  screens: { titulo: 'Promesas de fichín', txt: 'Marketing a la vieja escuela: sonido estéreo, niveles a todo color y una historia que te hará llorar. Lo del llanto no lo pudimos comprobar.' },
  'fondos-videojuegos': { titulo: 'Videojuegos', txt: '' },
  'fondos-peliculas': { titulo: 'Películas', txt: '' },
};
const item = (g: ItemGaleria) => ({
  img: g.img,
  caption: g.titulo,
  sub: [fecha(g.fecha), g.descripcion].filter(Boolean).join(' · ') || undefined,
  fecha: fecha(g.fecha) || '',
  desc: g.descripcion || '',
});
const fanart = fanartData as FanArt[];
const concurso = fanart.filter((f) => !f.mini);
const miniFans = fanart.filter((f) => f.mini);
// El origen ("Concurso Fan-Art 2017") ya lo dice el título de cada bloque: en la ficha va solo autor y título
const fanItem = (f: FanArt) => ({ img: f.img, caption: f.autor, sub: f.titulo || undefined });

const cats: { id: ItemGaleria['categoria']; titulo: string; txt: string }[] = [
  { id: 'afiche', titulo: 'Afiches', txt: 'Juanito cambió de nombre, de logo y de estilo. Pero nunca se cambió el pijama.' },
  { id: 'concept', titulo: 'Concept art y bocetos', txt: '' },
  { id: 'fondos', titulo: 'Fondos', txt: 'Pensados como wallpapers. ¡Todo tan demodé!' },
  { id: 'posters', titulo: 'Pósters', txt: 'Edición limitada, a $25 cada uno. Con 25 pesos te hacías alto guiso. Pero el guiso no te adorna la pared.' },
  { id: 'merch', titulo: 'Merch', txt: 'Remeras.' },
  { id: 'promo', titulo: 'Piezas de difusión', txt: 'Fechas especiales, hitos y campañas en redes.' },
];
// Afiches: orden elegido por el dueño, en dos filas (2 arriba y 3 abajo) para que se vean más grandes
const ordenAfiches = ['poster-limpio', 'logo-en-el-cielo', 'poster-clasico', 'ascii-codename-juanito', 'poster-v3'];
const filasAfiches = [2, 3];
// Piezas de difusión: mosaico de 7 columnas × 6 filas a todo el ancho, sin huecos.
// `lugar` es la posición en PC (fila inicio / columna inicio / fila fin / columna fin); en el celular
// se ignora y las piezas siguen el orden de la lista, que es por fecha.
// Las que ya están en la línea de tiempo no se muestran acá: si cambia esa lista, revisar estos lugares.
const ordenPromo = [
  'puro-games', 'the-hum', 'dia-del-nino-2014', 'halloween-2014', 'navidad-2014', 'navidad-2015',
  'afiche-twitter', 'celestineia', 'juanito-radio', 'concurso-fan-art', 'sonic-mania', 'mercado-libre',
  'mas-barato-que-un-combo', 'pagalo-como-quieras', 'chaala-e-chalaaa', 'san-patricio-2018',
  'san-patricio-olla', 'martes-13-2018',
];
// Seis grandes (2×2) que no quedan pegadas lado a lado, y las dos Navidades una sobre la otra.
const formaPromo: Record<string, { forma?: 'ancha' | 'grande'; lugar: string }> = {
  'dia-del-nino-2014': { forma: 'grande', lugar: '1 / 1 / 3 / 3' },
  'juanito-radio': { lugar: '1 / 3 / 2 / 4' },
  'concurso-fan-art': { forma: 'grande', lugar: '1 / 4 / 3 / 6' },
  'puro-games': { forma: 'ancha', lugar: '1 / 6 / 2 / 8' },
  'mercado-libre': { lugar: '2 / 3 / 3 / 4' },
  'afiche-twitter': { forma: 'grande', lugar: '2 / 6 / 4 / 8' },
  'navidad-2014': { forma: 'ancha', lugar: '3 / 1 / 4 / 3' },
  'sonic-mania': { forma: 'grande', lugar: '3 / 3 / 5 / 5' },
  'mas-barato-que-un-combo': { lugar: '3 / 5 / 4 / 6' },
  'navidad-2015': { forma: 'ancha', lugar: '4 / 1 / 5 / 3' },
  'the-hum': { forma: 'ancha', lugar: '4 / 5 / 5 / 7' },
  'pagalo-como-quieras': { lugar: '4 / 7 / 5 / 8' },
  'san-patricio-olla': { forma: 'grande', lugar: '5 / 1 / 7 / 3' },
  'halloween-2014': { forma: 'ancha', lugar: '5 / 3 / 6 / 5' },
  'martes-13-2018': { forma: 'grande', lugar: '5 / 5 / 7 / 7' },
  'chaala-e-chalaaa': { lugar: '5 / 7 / 6 / 8' },
  celestineia: { forma: 'ancha', lugar: '6 / 3 / 7 / 5' },
  'san-patricio-2018': { lugar: '6 / 7 / 7 / 8' },
};
const slugDe = (g: ItemGaleria) => g.img.split('/').pop()!.replace(/\.\w+$/, '');
const sueltos = (id: ItemGaleria['categoria']) => {
  const lista = galeria.filter((g) => g.categoria === id && !g.serie);
  const orden = id === 'afiche' ? ordenAfiches : id === 'promo' ? ordenPromo : null;
  if (!orden) return lista;
  const pos = (g: ItemGaleria) => (orden.indexOf(slugDe(g)) + 1 || 99);
  return lista.slice().sort((a, b) => pos(a) - pos(b));
};
// parte la lista en filas de n columnas (la última fila se lleva lo que sobre)
const enFilas = (lista: ItemGaleria[], filas: number[]) => {
  const out: { cols: number; items: ItemGaleria[] }[] = [];
  let i = 0;
  filas.forEach((n, k) => {
    const items = k === filas.length - 1 ? lista.slice(i) : lista.slice(i, i + n);
    if (items.length) out.push({ cols: n, items });
    i += n;
  });
  return out;
};
const presentes = cats.filter((c) => galeria.some((g) => g.categoria === c.id));
const artbook = galeria.filter((g) => g.categoria === 'artbook');
const portadaArtbook = maybeAsset(artbook[0]?.img);
---

<Base title="Galería" description="Arte, afiches, merch y el fan art de Juanito Arcade Mayhem.">
  <PageHeader eyebrow="Galería" title='Arte, afiches <span class="hl">y fan art</span>' lead="Afiches, concept art, fondos, merch y los dibujos que hizo la comunidad.">
    <nav class="jump" aria-label="Categorías">
      {presentes.map((c) => <a href={`#${c.id}`}>{c.titulo}</a>)}
      {artbook.length > 0 && <a href="#artbook">Artbook</a>}
      <a href="#fanart">Fan art</a>
    </nav>
  </PageHeader>

  {
    presentes.map((c) => (
      <section class="section--tight" id={c.id}>
        <div class="container">
          <div data-reveal>
            <h2 class="h2">{c.titulo}</h2>
            {c.txt && <p class="lead">{c.txt}</p>}
          </div>
          {c.id === 'afiche' && enFilas(sueltos('afiche'), filasAfiches).map((f) => (
            <div class="gap">
              <Gallery group="afiche" grilla limpia columnas={f.cols} items={f.items.map(item)} />
            </div>
          ))}
          {c.id !== 'afiche' && galeria.some((g) => g.categoria === c.id && !g.serie) && (
            <div class="gap">
              <Gallery
                group={c.id}
                limpia={c.id === 'posters' || c.id === 'promo'}
                mosaico={c.id === 'promo'}
                grilla={c.id === 'posters'}
                columnas={c.id === 'posters' ? 3 : undefined}
                items={sueltos(c.id).map((g) => ({ ...item(g), ...(c.id === 'promo' ? formaPromo[slugDe(g)] : {}) }))} />
            </div>
          )}
          {[...new Set(galeria.filter((g) => g.categoria === c.id && g.serie).map((g) => g.serie!))].map((s) => (
            <div class="serie">
              <h3 class="h3">{series[s]?.titulo ?? s}</h3>
              {series[s]?.txt && <p class="muted">{series[s].txt}</p>}
              <div class="gap">
                <Gallery
                  group={`${c.id}-${s}`}
                  min="300px"
                  grilla
                  celular1={c.id === 'fondos'}
                  limpia={c.id === 'fondos'}
                  sinTexto={s === 'screens'}
                  columnas={s === 'fondos-videojuegos' ? 2 : undefined}
                  items={galeria.filter((g) => g.categoria === c.id && g.serie === s).map(item)} />
              </div>
            </div>
          ))}
        </div>
      </section>
    ))
  }

  {
    artbook.length > 0 && (
      <section class="section" id="artbook">
        <div class="container artbook">
          <div class="book" data-reveal aria-hidden="true">
            <div class="book__cover">{portadaArtbook && <Image src={portadaArtbook} alt="" widths={[400, 700]} sizes="320px" />}</div>
            <div class="book__pages" />
          </div>
          <div data-reveal>
            <p class="eyebrow">Edición de colección</p>
            <h2 class="h2">
              The Art Book <span class="hl">de Juanito</span>
            </h2>
            <p class="lead">
              Bocetos, personajes, mundos y clonocélulas de todas las generaciones. Acá van algunas páginas de muestra; el libro completo es
              un DLC de Steam.
            </p>
            <a class="btn btn--primary" href="https://store.steampowered.com/app/684241/" target="_blank" rel="noopener">
              Ver en Steam
            </a>
          </div>
        </div>
        <div class="container gap">
          <Gallery group="artbook" items={artbook.slice(1).map((g) => ({ img: g.img, caption: g.titulo }))} />
        </div>
      </section>
    )
  }

  <section class="section" id="fanart">
    <div class="container">
      <div data-reveal>
        <p class="eyebrow">Fan art</p>
        <h2 class="h2">La comunidad <span class="hl">lo dibujó</span></h2>
        <p class="lead">
          {concurso.length} increíbles dibujos para el Concurso Fan-Art de 2017.<br />
          Gracias a cada persona que se tomó el tiempo de enviar su versión de Juanito.
        </p>
      </div>
      <div class="gap">
        <Gallery group="fanart" min="200px" pie items={concurso.map(fanItem)} />
      </div>
      {
        miniFans.length > 0 && (
          <div class="serie" id="mini-fans">
            <h3 class="h3">Mini fans</h3>
            <p class="muted">Alek tenía 6 años cuando nos mandó estos dibujos, en 2018. ¡Gracias, Alek!</p>
            <div class="gap">
              <Gallery group="mini-fans" grilla columnas={2} pie items={miniFans.map(fanItem)} />
            </div>
          </div>
        )
      }
    </div>
  </section>
  <Lightbox />
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.5rem;
  }
  .jump a {
    font-family: var(--font-ui);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
  }
  .jump a:hover {
    color: var(--lime);
    background: rgb(255 255 255 / 0.07);
  }
  section[id] {
    scroll-margin-top: 100px;
  }
  .lead {
    margin: 0.6rem 0 0;
  }
  .gap {
    margin-top: 1.5rem;
  }
  .serie {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .serie .h3,
  .serie p {
    margin: 0;
  }
  .serie p {
    margin-top: 0.35rem;
  }
  .artbook {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .artbook .btn {
    margin-top: 1.4rem;
  }
  .book {
    position: relative;
    perspective: 1400px;
    width: 300px;
    height: 400px;
    margin-inline: auto;
  }
  .book__cover,
  .book__pages {
    position: absolute;
    inset: 0;
  }
  .book__pages {
    background: repeating-linear-gradient(90deg, #e9f4ee 0 2px, #cfdcd5 2px 3px);
    translate: 14px 8px;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.8);
  }
  .book__cover {
    z-index: 1;
    transform-origin: left center;
    transform: rotateY(-18deg);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 10px 20px 50px -10px rgb(0 0 0 / 0.8), 0 0 40px rgb(44 224 108 / 0.25);
    background: var(--night);
    overflow: hidden;
  }
  .book:hover .book__cover {
    transform: rotateY(-38deg);
  }
  .book__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 800px) {
    .artbook {
      grid-template-columns: 1fr;
    }
  }
</style>
